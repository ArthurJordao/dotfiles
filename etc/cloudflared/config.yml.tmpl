{{- $domain := .domain -}}
# GENERATED from .chezmoidata/hosts.yaml — set `public: true` on an endpoint there.
tunnel: e5653e06-8ef3-4810-a2dc-3d730d73e949
credentials-file: /home/turisa/.cloudflared/e5653e06-8ef3-4810-a2dc-3d730d73e949.json

# Public ingress via Cloudflare Tunnel — no open ports. LAN/Tailscale clients
# still resolve via CoreDNS, so these routes only affect outside traffic.
# Each hostname needs its public CNAME created once:
#   cloudflared tunnel route dns <tunnel-id> <hostname>
#
# 127.0.0.1, not localhost — rootless pasta containers only forward IPv4.
ingress:
{{- range $hostname, $host := .hosts }}
{{- range (index $host "endpoints" | default list) }}
{{- if and (hasKey . "port") (index . "public" | default false) }}
  - hostname: {{ .name }}.{{ $domain }}
    service: http://127.0.0.1:{{ .port }}
{{- end }}{{ end }}{{ end }}
  - service: http_status:404
