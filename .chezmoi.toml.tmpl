sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
  is_mac = {{ eq .chezmoi.os "darwin" }}
  is_linux = {{ eq .chezmoi.os "linux" }}
  hostname = {{ .chezmoi.hostname | quote }}

[onepassword]
  command = "op"

# Runs after the repo is cloned but before chezmoi reads source state, so `op`
# exists before any template that reads a 1Password secret needs it. Exits
# immediately when the CLI is already installed.
[hooks.read-source-state.pre]
  command = {{ printf "%s/.install-password-manager.sh" .chezmoi.sourceDir | quote }}
