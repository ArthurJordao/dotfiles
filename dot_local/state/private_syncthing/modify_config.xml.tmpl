#!/usr/bin/env python3
{{- $me := index .hosts .hostname -}}
{{- $myId := index $me "syncthing_id" | default "" -}}
{{- $peers := list -}}
{{- range $name, $h := .hosts -}}
{{-   if and (has "emulation" (index $h "roles" | default list)) (ne (index $h "syncthing_id" | default "") "") -}}
{{-     $peers = append $peers $name -}}
{{-   end -}}
{{- end }}
# GENERATED from .chezmoidata/syncthing.yaml — do not edit the deployed copy.
#
# A `modify_` script, not a plain template: syncthing co-owns this file (apikey,
# its own <device>, schema migrations, expanded defaults), so we take the
# current file on stdin and own only the <folder> and top-level <device>
# elements plus a few <options>. Everything else passes through untouched.
#
# The transform must be IDEMPOTENT: chezmoi diffs our stdout against the file on
# disk, so re-running on our own output has to be byte-identical.
import sys
import xml.etree.ElementTree as ET

FOLDERS = [
{{- range $f := .syncthing.folders }}
{{- $type := "sendreceive" }}
{{- if eq $f.mode "oneway" }}
{{-   if eq $f.source $.hostname }}{{ $type = "sendonly" }}{{ else }}{{ $type = "receiveonly" }}{{ end }}
{{- end }}
{{- /* `except` lists hosts that do NOT get the folder; absent means all peers.
       An excluded host omits the folder ENTIRELY: a <folder> in a config is a
       folder that device holds, and its <device> children are only who it
       shares with. Dropping ourselves from that list would still sync it. */ -}}
{{- $except := index $f "except" | default list }}
{{- if not (has $.hostname $except) }}
{{- $members := list }}
{{- range $p := $peers }}{{ if not (has $p $except) }}{{ $members = append $members (index $.hosts $p).syncthing_id }}{{ end }}{{ end }}
    ({{ $f.id | quote }}, {{ $f.path | quote }}, {{ $type | quote }}, {{ ternary "True" "False" (eq $f.mode "twoway") }}, [{{ range $i, $m := $members }}{{ if $i }}, {{ end }}{{ $m | quote }}{{ end }}]),
{{- end }}
{{- end }}
]

# (device id, name, [addresses]). "dynamic" for ourselves.
#
# Peers get BOTH their LAN and Tailscale addresses: syncthing dials each and
# keeps whichever connects, so it uses the wire at home and Tailscale away.
# Tailscale alone would tunnel even a local transfer when discovery fails.
DEVICES = [
{{- range $p := $peers }}
{{- $h := index $.hosts $p }}
{{- if eq $p $.hostname }}
    ({{ $h.syncthing_id | quote }}, {{ $p | quote }}, ["dynamic"]),
{{- else }}
    ({{ $h.syncthing_id | quote }}, {{ $p | quote }}, [{{ printf "tcp://%s:22000" $h.ip.lan | quote }}, {{ printf "tcp://%s:22000" $h.ip.tailscale | quote }}]),
{{- end }}
{{- end }}
]

MY_ID = {{ $myId | quote }}

{{- /* `index`, not `| default`: sprig treats false as empty and flips it. */}}
IGNORE_PERMS = {{ ternary "True" "False" (eq (index $me "syncthing_ignore_perms" | toString) "true") }}

OPTIONS = {
    "globalAnnounceEnabled": "false",
    "localAnnounceEnabled": "true",
    "relaysEnabled": "false",
    "natEnabled": "false",
    "urAccepted": "-1",
    "crashReportingEnabled": "false",
    # Default 0 = hash every folder at once, which starves mars off the network.
    "maxFolderConcurrency": "2",
}
GUI_ADDRESS = "127.0.0.1:8384"

# Used only when there is no config yet; syncthing expands it on first start.
# Seed at the OLDEST version in the fleet: a newer syncthing migrates forward,
# but an older one refuses a config newer than it supports. Debian's 1.29.5
# caps at 37, Arch's is on 52.
SEED = '<configuration version="37"></configuration>'


def build_folder(fid, path, ftype, versioned, members, paused="false"):
    el = ET.Element("folder", {
        "id": fid,
        "paused": paused,
        "label": fid,
        "path": "~/" + path,
        "type": ftype,
        "rescanIntervalS": "3600",
        "fsWatcherEnabled": "true",
        "fsWatcherDelayS": "10",
        "ignorePerms": "true" if IGNORE_PERMS else "false",
    })
    for did in members:
        ET.SubElement(el, "device", {"id": did, "introducedBy": ""})
    v = ET.SubElement(el, "versioning")
    if versioned:
        ET.SubElement(v, "type").text = "simple"
        ET.SubElement(v, "param", {"key": "keep", "val": "5"})
        ET.SubElement(v, "cleanupIntervalS").text = "3600"
    return el


def build_device(did, name, addrs, paused="false"):
    el = ET.Element("device", {
        "id": did,
        "name": name,
        "compression": "metadata",
        "introducer": "false",
        "skipIntroductionRemovals": "false",
        "introducedBy": "",
        # Operational state, not configuration: pausing is something you do at
        # runtime, so carry over whatever is on disk instead of resetting it.
        "paused": paused,
    })
    for a in addrs:
        ET.SubElement(el, "address").text = a
    ET.SubElement(el, "autoAcceptFolders").text = "false"
    return el


def set_child(parent, tag, text):
    el = parent.find(tag)
    if el is None:
        el = ET.SubElement(parent, tag)
    el.text = text


def main():
    current = sys.stdin.read()
    try:
        root = ET.fromstring(current if current.strip() else SEED)
    except ET.ParseError:
        # A corrupt config should not wedge apply; start clean.
        root = ET.fromstring(SEED)

    # No ID of our own, or no peer to pair with: leave folders and devices
    # alone rather than emitting half a topology.
    if MY_ID and len(DEVICES) > 1:
        # Carry the runtime paused flags across the rebuild.
        was_paused = {
            (e.tag, e.get("id")): e.get("paused", "false")
            for e in root if e.tag in ("folder", "device")
        }
        keep = [e for e in root if e.tag not in ("folder", "device")]
        root[:] = (
            [build_folder(*f, paused=was_paused.get(("folder", f[0]), "false"))
             for f in FOLDERS]
            + [build_device(*d, paused=was_paused.get(("device", d[0]), "false"))
               for d in DEVICES]
            + keep
        )

    opts = root.find("options")
    if opts is None:
        opts = ET.SubElement(root, "options")
    for key, val in OPTIONS.items():
        set_child(opts, key, val)

    gui = root.find("gui")
    if gui is None:
        gui = ET.SubElement(root, "gui")
    set_child(gui, "address", GUI_ADDRESS)

    ET.indent(root, space="    ")
    out = ET.tostring(root, encoding="unicode")
    sys.stdout.write('<?xml version="1.0" encoding="UTF-8"?>\n' + out.rstrip() + "\n")


main()
