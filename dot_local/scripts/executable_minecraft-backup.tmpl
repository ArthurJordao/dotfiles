#!/usr/bin/env bash
# minecraft-backup — daily tarball of every instance's world, kept locally (newest
# KEEP) and pushed to pluto for real off-host retention.
#
# GENERATED — the instance list is .chezmoidata/minecraft.yaml.
#
# Backs up whichever world* dirs exist: newer MC keeps every dimension inside
# world/, older Paper split them into world_nether / world_the_end. An instance
# with none is skipped rather than failing the timer — it has never been run.
#
# If an instance is running, its saves are paused and flushed through its tmux
# console first. One instance's failure doesn't stop the rest; the exit status
# still reports it. Run by minecraft-backup.timer; safe by hand.
#
# The push to pluto is best-effort: a failure there marks the instance failed
# for the exit status, but never touches the local tarball already in place —
# mars's own copy must not regress because pluto was unreachable.
set -euo pipefail

INSTANCES=(
{{- range .minecraft.instances }}
    "{{ .name }}"
{{- end }}
)
DEST_DIR="$HOME/minecraft-backups"
REMOTE_HOST="pluto"
REMOTE_DIR="backups/minecraft"
REMOTE_KEEP_DAYS=30
KEEP=3

mkdir -p "$DEST_DIR"

mc_console() { tmux send-keys -t "$1" "$2" C-m 2>/dev/null || true; }

# Set while an instance is mid-backup, so dying between save-off and the rename
# still re-enables saves and drops the half-written tarball.
cur_session=""
cur_archive=""
cur_running=0

cleanup() {
    [ "$cur_running" -eq 1 ] && mc_console "$cur_session" "save-on"
    [ -n "$cur_archive" ] && rm -f "$cur_archive.part"
    return 0
}
trap cleanup EXIT

backup_instance() {
    local instance="$1"
    local src_dir="$HOME/minecraft/$instance"
    local archive name rc old
    archive="$DEST_DIR/${instance}-$(date +%F).tar.gz"

    local worlds=()
    for name in world world_nether world_the_end; do
        [ -d "$src_dir/$name" ] && worlds+=("$name")
    done
    if [ "${#worlds[@]}" -eq 0 ]; then
        echo "minecraft-backup: $instance: no world dirs under $src_dir, skipping"
        return 0
    fi

    cur_session="minecraft-$instance"
    cur_archive="$archive"
    cur_running=0
    if systemctl --user is-active --quiet "minecraft@$instance.service"; then
        cur_running=1
        mc_console "$cur_session" "save-off"
        mc_console "$cur_session" "save-all flush"
        sleep 5
    fi

    # Write to a .part name then rename, so a half-written tarball never looks final.
    rc=0
    tar -C "$src_dir" -czf "$archive.part" "${worlds[@]}" || rc=1

    [ "$cur_running" -eq 1 ] && mc_console "$cur_session" "save-on"
    cur_running=0

    if [ "$rc" -ne 0 ]; then
        rm -f "$archive.part"
        cur_archive=""
        echo "minecraft-backup: $instance: tar failed" >&2
        return 1
    fi
    # Checked explicitly: this runs under `|| failed+=`, which disables errexit
    # inside the function.
    if ! mv -f "$archive.part" "$archive"; then
        rm -f "$archive.part"
        cur_archive=""
        echo "minecraft-backup: $instance: could not rename into place" >&2
        return 1
    fi
    cur_archive=""

    # Match only the date-stamped names this script writes, so a hand-made
    # snapshot dropped in the same directory is never pruned.
    local backups=()
    mapfile -t backups < <(ls -1t "$DEST_DIR/${instance}-"[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].tar.gz 2>/dev/null || true)
    if [ "${#backups[@]}" -gt "$KEEP" ]; then
        for old in "${backups[@]:$KEEP}"; do
            rm -f "$old"
        done
    fi

    echo "minecraft-backup: $instance: wrote $archive ($(du -h "$archive" | cut -f1)) [dirs: ${worlds[*]}]; kept newest $KEEP"

    # $REMOTE_DIR and $instance are local values; expanding them client-side
    # before they reach the remote shell is intended, not a mistake.
    # shellcheck disable=SC2029
    if ! ssh "$REMOTE_HOST" "mkdir -p '$REMOTE_DIR'" ||
       ! rsync -az "$archive" "$REMOTE_HOST:$REMOTE_DIR/" ||
       ! ssh "$REMOTE_HOST" "find '$REMOTE_DIR' -name '${instance}-*.tar.gz' -mtime +$REMOTE_KEEP_DAYS -delete"; then
        echo "minecraft-backup: $instance: push to $REMOTE_HOST failed (local copy is unaffected)" >&2
        return 1
    fi
    echo "minecraft-backup: $instance: pushed to $REMOTE_HOST:$REMOTE_DIR, kept newest ${REMOTE_KEEP_DAYS}d"
}

failed=()
for instance in "${INSTANCES[@]}"; do
    backup_instance "$instance" || failed+=("$instance")
done

if [ "${#failed[@]}" -gt 0 ]; then
    echo "minecraft-backup: failed for: ${failed[*]}" >&2
    exit 1
fi
