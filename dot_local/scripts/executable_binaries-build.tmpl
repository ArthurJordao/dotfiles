#!/bin/bash
# binaries-build -- compile every `local-build` binary at its pinned version.
#
#   binaries-build            build any whose installed version != its pin
#   binaries-build --force    build regardless
#
# Deliberately not part of `chezmoi apply`: a caddy build is about seven
# minutes on this box, and an apply that stalls that long is worse than a stale
# binary. install-packages reports these; this is what acts on them.
set -uo pipefail

FORCE=0
for arg in "$@"; do
    case "$arg" in
        --force) FORCE=1 ;;
        -h | --help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

{{ template "binaries.sh" . }}
{{ template "binaries-expand.sh" . }}
{{ template "binaries-build.sh" . }}

declared=0
failed=0

while IFS='|' read -r bname _ bversion bkind _ _ bvercmd brestart btoolchain bbuild; do
    [ -n "$bname" ] || continue
    [ "$bkind" = "local-build" ] || continue
    declared=$((declared + 1))

    have=$(bin_installed "$bname" "$bkind" "$bvercmd")
    if [ "$FORCE" = "0" ] && [ "$have" = "$bversion" ]; then
        echo "$bname $bversion already installed"
        continue
    fi

    echo "Building $bname $bversion (from ${have:-absent}) -- this takes a while"
    if bin_build "$bname" "$bversion" "$bbuild" "$btoolchain" "$brestart"; then
        now=$(bin_installed "$bname" "$bkind" "$bvercmd")
        if [ "$now" = "$bversion" ]; then
            echo "$bname is now $now"
        else
            # A build that lands but reports the wrong version is worse than a
            # failed one: nothing downstream would notice.
            echo "$bname: installed but reports '${now:-nothing}', wanted $bversion" >&2
            failed=$((failed + 1))
        fi
    else
        failed=$((failed + 1))
    fi
done <<BINEOF
$BINARIES
BINEOF

[ "$declared" = "0" ] && echo "No local-build binaries declared for this host."
[ "$failed" = "0" ] || exit 1
exit 0
