#!/usr/bin/env bash
# minecraft-backup — daily tarball of the vanilla world, stored on the bulk SSD
# (/mnt/x9pro) so a root-disk (nvme0n1) failure doesn't take the backups with it.
# Keeps only the newest KEEP daily tarballs.
#
# On MC 26.2 every dimension lives inside world/ (world/dimensions/minecraft/...);
# older Paper split them into world_nether / world_the_end. We back up whichever
# world* dirs exist, so either layout works.
#
# If the server is running, saves are paused and flushed through its tmux console
# first for a consistent snapshot, and re-enabled via the EXIT trap (which also
# removes any half-written tarball). Run by minecraft-backup.timer; safe by hand.
set -euo pipefail

INSTANCE="vanilla"
SRC_DIR="$HOME/minecraft/$INSTANCE"
DEST_DIR="/mnt/x9pro/minecraft-backups"
KEEP=3
SESSION="minecraft-$INSTANCE"

mkdir -p "$DEST_DIR"
archive="$DEST_DIR/${INSTANCE}-$(date +%F).tar.gz"

mc_console() { tmux send-keys -t "$SESSION" "$1" C-m 2>/dev/null || true; }

running=0
if systemctl --user is-active --quiet "minecraft@$INSTANCE.service"; then
    running=1
fi

# On any exit: re-enable saves and drop a half-written tarball if tar failed.
cleanup() {
    [ "$running" -eq 1 ] && mc_console "save-on"
    rm -f "$archive.part"
    return 0
}
trap cleanup EXIT

# Collect the world dir(s) that exist (handles 26.2 unified + old split layouts).
worlds=()
for name in world world_nether world_the_end; do
    [ -d "$SRC_DIR/$name" ] && worlds+=("$name")
done
if [ "${#worlds[@]}" -eq 0 ]; then
    echo "minecraft-backup: no world dirs under $SRC_DIR" >&2
    exit 1
fi

# Pause world writes and flush pending chunks for a consistent snapshot.
if [ "$running" -eq 1 ]; then
    mc_console "save-off"
    mc_console "save-all flush"
    sleep 5
fi

# Write to a .part name then rename, so a half-written tarball never looks final.
tar -C "$SRC_DIR" -czf "$archive.part" "${worlds[@]}"
mv -f "$archive.part" "$archive"

# Retention: keep the newest KEEP tarballs, delete the rest.
mapfile -t backups < <(ls -1t "$DEST_DIR/${INSTANCE}-"*.tar.gz 2>/dev/null || true)
if [ "${#backups[@]}" -gt "$KEEP" ]; then
    for old in "${backups[@]:$KEEP}"; do
        rm -f "$old"
    done
fi

echo "minecraft-backup: wrote $archive ($(du -h "$archive" | cut -f1)) [dirs: ${worlds[*]}]; kept newest $KEEP"
