#!/bin/bash
# GENERATED from .chezmoidata/firewall.yaml -- edit the rules there.
#
# Rebuilt whole, not patched: ufw is first-match, so the data file's order is
# the ruleset's order. Not run by `chezmoi apply` -- `ufw --force reset` leaves
# the box unprotected until the enable at the end.
set -euo pipefail

{{ $rules := index .firewall .hostname -}}

# /usr/sbin is not on a non-root PATH on Debian, so `command -v ufw` says no to
# a binary that is there. Every call below goes through sudo, which finds it.
if ! command -v ufw >/dev/null 2>&1 && [ ! -x /usr/sbin/ufw ]; then
    echo "ufw is not installed. Run ~/.local/scripts/install-packages first." >&2
    exit 1
fi

echo "Rebuilding the ufw ruleset for {{ .hostname }}."
echo "The firewall is down while this runs; established connections survive."

sudo ufw --force reset
sudo ufw default deny incoming
sudo ufw default allow outgoing

# Hardcoded and first: no later rule undoes a lockout.
sudo ufw allow 22 comment 'ssh'

{{ range $rules }}
sudo ufw {{ .rule | replace "{lan_cidr}" $.lan_cidr }} comment '{{ .comment }}'
{{- end }}

sudo ufw --force enable

echo
echo "Final ruleset -- check the order against .chezmoidata/firewall.yaml:"
sudo ufw status numbered
