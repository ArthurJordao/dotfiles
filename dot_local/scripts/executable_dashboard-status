#!/usr/bin/env bash
# dashboard-status — ONE JSON object for OliveTin's `status` entity.
#
# One row on purpose: OliveTin repeats the whole fieldset per entity row, so a
# row each would mean a heading each. Colors come in from the environment, so
# the palette stays in chezmoi data rather than in this script.
set -uo pipefail

GOOD="${GOOD:-green}"
BAD="${BAD:-red}"
WARN="${WARN:-orange}"

# Minecraft — instances are mutually exclusive, so at most one is active.
mc=$(systemctl --user list-units --plain --no-legend --state=active 'minecraft@*.service' 2>/dev/null |
     awk '{print $1}' | head -1 | sed 's/^minecraft@//; s/\.service$//')
if [ -n "$mc" ]; then mc_color="$GOOD"; else mc="stopped"; mc_color="$WARN"; fi

# Gaming mode — the state file exists only while it is on.
if [ -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gaming-mode.units" ]; then
    gm="on"; gm_color="$WARN"
else
    gm="off"; gm_color="$GOOD"
fi

# app-* is the desktop session's launcher namespace -- on a box that is also a
# workstation those come and go, and counting them makes this cry wolf.
mapfile -t bad_units < <(systemctl --user list-units --failed --plain --no-legend 2>/dev/null |
                         awk '{print $1}' | grep -v '^app-' | sed 's/\.service$//')
case ${#bad_units[@]} in
    0) failed="none"; failed_color="$GOOD" ;;
    1) failed="${bad_units[0]}"; failed_color="$BAD" ;;
    *) failed="${#bad_units[@]} units"; failed_color="$BAD" ;;
esac

# Hand-installed binaries -- check-binaries.timer writes this daily. A file
# read, not a network call: this runs on every status refresh.
bin_cache="${XDG_STATE_HOME:-$HOME/.local/state}/check-binaries.status"
if [ -r "$bin_cache" ]; then
    bins=$(sed -n 1p "$bin_cache")
    case $(sed -n 2p "$bin_cache") in
        good) bins_color="$GOOD" ;;
        warn) bins_color="$WARN" ;;
        *)    bins_color="$BAD" ;;
    esac
else
    bins="n/a"
    bins_color="$WARN"
fi
# The value goes into JSON built by printf; a quote or backslash would break it.
bins=${bins//\"/}
bins=${bins//\\/}

# Paper builds on mars -- check-paper-remote.timer writes this daily. A file
# read, not a network call: this runs on every status refresh. A stale value is
# kept and coloured WARN rather than blanked, because mars is often off.
paper_cache="${XDG_STATE_HOME:-$HOME/.local/state}/check-paper.status"
if [ -r "$paper_cache" ]; then
    paper=$(sed -n 1p "$paper_cache")
    case $(sed -n 2p "$paper_cache") in
        good) paper_color="$GOOD" ;;
        warn) paper_color="$WARN" ;;
        *)    paper_color="$BAD" ;;
    esac
else
    paper="n/a"
    paper_color="$WARN"
fi
paper=${paper//\"/}
paper=${paper//\\/}

# Warn late: disks fill slowly and a nag is worse than no signal.
disk_color() {
    local n=${1%\%}
    # Not every host has every mount; a missing one is not a warning to colour.
    case $n in '' | *[!0-9]*) printf '%s' "$WARN"; return ;; esac
    if [ "$n" -ge 90 ]; then printf '%s' "$BAD"
    elif [ "$n" -ge 75 ]; then printf '%s' "$WARN"
    else printf '%s' "$GOOD"; fi
}
root=$(df --output=pcent / 2>/dev/null | tail -1 | tr -d ' ')
ext=$(df --output=pcent /mnt/x9pro 2>/dev/null | tail -1 | tr -d ' ')
ext=${ext:-n/a}

# Service probes. A TCP connect, which answers "is something listening" without
# caring about TLS or HTTP semantics. Each argument is name:port for a service
# on this host, or name:host:port for one reached over the network -- minecraft
# lives on another box and still earns a field.
svc_fields=""
for spec in "$@"; do
    name=${spec%%:*}
    port=${spec##*:}
    rest=${spec#*:}
    # Two fields means no host was given; probe loopback. 127.0.0.1, never
    # localhost: rootless containers use pasta, which forwards IPv4 only.
    if [ "$rest" = "$port" ]; then host=127.0.0.1; else host=${rest%:*}; fi
    key=${name//-/_}
    if timeout 2 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
        svc_fields="$svc_fields\"svc_$key\":\"up\",\"svc_${key}_color\":\"$GOOD\","
    else
        svc_fields="$svc_fields\"svc_$key\":\"down\",\"svc_${key}_color\":\"$BAD\","
    fi
done

printf '{%s"mc":"%s","mc_color":"%s","gm":"%s","gm_color":"%s","failed":"%s","failed_color":"%s","binaries":"%s","binaries_color":"%s","paper":"%s","paper_color":"%s","root":"%s","root_color":"%s","ext":"%s","ext_color":"%s"}\n' \
    "$svc_fields" "$mc" "$mc_color" "$gm" "$gm_color" "$failed" "$failed_color" \
    "$bins" "$bins_color" \
    "$paper" "$paper_color" \
    "$root" "$(disk_color "$root")" "$ext" "$(disk_color "$ext")"
