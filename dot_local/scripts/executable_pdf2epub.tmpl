{{- $media := includeTemplate "storage-path" (dict "hosts" .hosts "name" "media") -}}
#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pymupdf4llm==1.28.2"]
# ///
"""pdf2epub -- convert PDFs waiting in CWA's ingest dir into EPUBs.

calibre's PDF input interleaves page furniture into the body text and leaves
hyphenated line breaks literal. pymupdf4llm reflows properly; pandoc turns its
markdown into EPUB, which CWA then ingests as it would any upload.

CWA must have `pdf` in auto_ingest_ignored_formats or it converts them first.
"""

import os
import re
import shutil
import subprocess
import xml.etree.ElementTree as ET
import zipfile
import sys
import tempfile
from collections import Counter
from pathlib import Path

MEDIA = Path(os.path.expanduser("{{ $media }}".replace("%h", "~")))
INGEST = MEDIA / "book-ingest"
# Deliberately a SIBLING of the ingest dir, never a subdirectory of it. CWA's
# polling watcher walks the tree and re-emits CLOSE_WRITE every scan for any
# file whose mtime is older than its stabilize window -- the sentinel that is
# meant to stop a refire only defeats the other half of that condition. So a
# PDF left anywhere under the ingest dir spins a full ingest-processor every
# 5 seconds forever.
ARCHIVE = MEDIA / "book-archive"
FAILED = ARCHIVE / "failed"
STATUS = Path(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))) / "pdf2epub.status"

# CWA prefixes uploads with new_<n>_<date>_<time>_<rand>_. Strip it so the
# EPUB carries a sane title rather than the upload's bookkeeping.
UPLOAD_PREFIX = re.compile(r"^new_\d+_\d{8}_\d{6}_\d+_")

# pymupdf4llm emits raw <sup>/<sub> for maths. pandoc passes raw HTML through
# verbatim while applying _.._ emphasis independently, so the two interleave --
# <sup><em>d_model</sup><sup></em>xdk</sup> -- and the EPUB is not well-formed
# XML, which readers reject outright. Strip the tags and let pandoc own the
# markup; the inner text survives.
HTML_TAG = re.compile(r"</?[A-Za-z][^>]*>")
# pymupdf4llm marks italics with underscores. Once the tags around them are
# gone pandoc prints them literally (_Wi__Q_), so they have to go too.
STRAY_UNDERSCORE = re.compile(r"(?<=\w)_+(?=\W)|(?<=\W)_+(?=\w)")

# Furniture is positional as well as repetitive: a running header or footer sits
# at the top or bottom of its page. Matching on repetition alone deletes body
# text, because normalise() strips digits and similar sentences then collide.
# Headers run ~45 chars; pymupdf4llm emits each body paragraph as one ~250-char
# line, so the gap is wide. Known limit: short numbered lines that sit at a page
# edge on most pages and differ only by their number are removed as furniture.
MAX_FURNITURE_LEN = 70
MIN_REPEATS = 3
FURNITURE_PAGE_FRACTION = 0.25
EDGE_LINES = 2


def normalise(line):
    """Page furniture differs only by its page number.

    A bare page number normalises to nothing, so it gets its own key rather than
    an empty one -- otherwise it is never counted and never stripped.
    """
    stripped = line.strip()
    if stripped and not re.sub(r"[\d\s.,ivxlcIVXLC-]+", "", stripped):
        return "\x00pagenum"
    return re.sub(r"\d+", "", stripped).strip().lower()


def edge_indices(lines):
    """Indices of the first and last few non-blank lines -- where furniture sits."""
    filled = [i for i, line in enumerate(lines) if line.strip()]
    return set(filled[:EDGE_LINES]) | set(filled[-EDGE_LINES:])


def strip_furniture(pages):
    """Drop repeated page-edge lines -- running headers and footers."""
    split = [page.splitlines() for page in pages]
    counts = Counter()
    for lines in split:
        seen = set()
        for i in edge_indices(lines):
            stripped = lines[i].strip()
            if len(stripped) > MAX_FURNITURE_LEN:
                continue
            key = normalise(stripped)
            if key and key not in seen:
                seen.add(key)
                counts[key] += 1

    threshold = max(MIN_REPEATS, int(len(pages) * FURNITURE_PAGE_FRACTION))
    furniture = {key for key, n in counts.items() if n >= threshold}
    if not furniture:
        return "\n".join(pages)

    kept = []
    for lines in split:
        edges = edge_indices(lines)
        kept.append(
            "\n".join(
                line
                for i, line in enumerate(lines)
                if not (
                    i in edges
                    and line.strip()
                    and len(line.strip()) <= MAX_FURNITURE_LEN
                    and normalise(line.strip()) in furniture
                )
            )
        )
    return "\n".join(kept)


def convert(pdf, workdir, dest):
    import pymupdf4llm

    images = workdir / "img"
    images.mkdir(parents=True, exist_ok=True)
    chunks = pymupdf4llm.to_markdown(
        str(pdf),
        page_chunks=True,
        write_images=True,
        image_path=str(images),
        image_format="jpg",
    )
    # Superscripts flatten into the line. Mapping them to pandoc's ^x^ was
    # tried and is worse: a stray caret in the text pairs with one of ours and
    # swallows everything between, re-nesting the tags it was meant to fix.
    markdown = strip_furniture([c["text"] for c in chunks])
    markdown = STRAY_UNDERSCORE.sub("", HTML_TAG.sub("", markdown))

    md_path = workdir / "book.md"
    md_path.write_text(markdown, encoding="utf-8")

    title = UPLOAD_PREFIX.sub("", pdf.stem).replace("_", " ").strip() or pdf.stem
    epub = dest / (pdf.stem + ".epub")
    subprocess.run(
        [
            "pandoc", str(md_path),
            "-o", str(epub),
            # Belt and braces with HTML_TAG above: anything tag-shaped that got
            # through is escaped as text rather than passed into the XHTML.
            "-f", "markdown-raw_html",
            "--toc", "--toc-depth=2",
            # Without this pandoc drops every image with only a warning.
            "--resource-path", str(workdir),
            "--metadata", "title=" + title,
        ],
        check=True,
    )
    validate(epub)
    return epub


def validate(epub):
    """A malformed EPUB is rejected by readers, so fail here instead."""
    with zipfile.ZipFile(epub) as z:
        for name in z.namelist():
            if not name.endswith((".xhtml", ".opf", ".ncx")):
                continue
            try:
                ET.fromstring(z.read(name))
            except ET.ParseError as exc:
                raise RuntimeError("%s is not well-formed XML: %s" % (name, exc)) from exc


def write_status(pending, failed):
    if failed:
        text, severity = "%d failed" % failed, "bad"
    elif pending:
        text, severity = "%d pending" % pending, "warn"
    else:
        text, severity = "none", "good"
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    STATUS.write_text(text + "\n" + severity + "\n", encoding="utf-8")


def main():
    if not INGEST.is_dir():
        print("pdf2epub: no ingest dir at %s" % INGEST, file=sys.stderr)
        return 1

    ARCHIVE.mkdir(parents=True, exist_ok=True)
    pdfs = sorted(p for p in INGEST.glob("*.pdf") if p.is_file() and p.stat().st_size)
    for pdf in pdfs:
        # Move it out of the watched tree FIRST. Every second a PDF spends in
        # the ingest dir costs CWA one ingest-processor, and a conversion that
        # raises would otherwise leave it there spinning forever.
        source = ARCHIVE / pdf.name
        shutil.move(str(pdf), str(source))
        print("pdf2epub: converting %s" % pdf.name, flush=True)
        try:
            with tempfile.TemporaryDirectory() as tmp:
                epub = convert(source, Path(tmp), INGEST)
        except Exception as exc:  # noqa: BLE001 -- one bad PDF must not stop the rest
            print("pdf2epub: %s failed: %s" % (pdf.name, exc), file=sys.stderr)
            FAILED.mkdir(parents=True, exist_ok=True)
            shutil.move(str(source), str(FAILED / pdf.name))
            continue
        print("pdf2epub: wrote %s" % epub.name, flush=True)

    pending = len([p for p in INGEST.glob("*.pdf") if p.is_file()])
    failed = len(list(FAILED.glob("*.pdf"))) if FAILED.is_dir() else 0
    write_status(pending, failed)
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
