#!/usr/bin/env bash
# sunshine-client-mode — match the display mode to the streaming client.
#
#   sunshine-client-mode set      switch to the mode the client asked for
#   sunshine-client-mode restore  put the previous mode back
#
# Run from an apps.json prep-cmd; sunshine exports SUNSHINE_CLIENT_WIDTH,
# _HEIGHT and _FPS to both halves. Sunshine captures the physical connector, so
# the stream resolution is whatever the display is set to.
#
# Only a mode the display already advertises is used — an unlisted size leaves
# the display untouched rather than guessing. Nothing here may fail: a non-zero
# prep-cmd aborts the stream.
set -uo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$XDG_RUNTIME_DIR/sunshine-client-mode.previous"

# kscreen-doctor talks to KWin over Wayland, and sunshine's unit may not carry
# WAYLAND_DISPLAY.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    for sock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        if [ -S "$sock" ]; then
            WAYLAND_DISPLAY="${sock##*/}"
            break
        fi
    done
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
fi

apply() { # $1 = kscreen-doctor argument, e.g. output.HDMI-A-1.mode.11
    [ -n "$1" ] || return 0
    kscreen-doctor "$1" >/dev/null 2>&1 || echo "sunshine-client-mode: $1 failed" >&2
}

case "${1:-}" in
    set)
        # Prints the argument to apply, and records the current mode in $STATE.
        # The probe runs in here rather than being piped in: this heredoc is
        # already python's stdin, so a pipe would be swallowed.
        apply "$(python3 - \
            "${SUNSHINE_CLIENT_WIDTH:-}" "${SUNSHINE_CLIENT_HEIGHT:-}" \
            "${SUNSHINE_CLIENT_FPS:-}" "$STATE" <<'PY'
import json, os, subprocess, sys

try:
    want_w, want_h, want_fps, state = sys.argv[1:5]
    probe = subprocess.run(["kscreen-doctor", "-j"],
                           capture_output=True, text=True)
    outputs = json.loads(probe.stdout)["outputs"]
    want_w, want_h = int(want_w), int(want_h)
    want_fps = float(want_fps or 60)
except (ValueError, KeyError, OSError, json.JSONDecodeError):
    sys.exit(0)

active = [o for o in outputs if o.get("enabled")]
if not active:
    sys.exit(0)
out = min(active, key=lambda o: o.get("priority", 99))

# Exact size only; among those, the refresh closest to what the client asked
# for. Mode ids are what kscreen-doctor takes, and names are not unique —
# "1920x1080@60" appears twice at 60.00 and 59.94.
sized = [m for m in out["modes"]
         if m["size"]["width"] == want_w and m["size"]["height"] == want_h]
if not sized:
    sys.exit(0)
best = min(sized, key=lambda m: abs(m["refreshRate"] - want_fps))

current = str(out.get("currentModeId"))
if str(best["id"]) == current:
    sys.exit(0)

# Only if absent: a second `set` without a `restore` must not overwrite the
# real original with our own previous choice.
if not os.path.exists(state):
    with open(state, "w") as fh:
        fh.write("output.%s.mode.%s\n" % (out["name"], current))

print("output.%s.mode.%s" % (out["name"], best["id"]))
PY
        )"
        ;;
    restore)
        if [ -s "$STATE" ]; then
            apply "$(cat "$STATE")"
            rm -f "$STATE"
        fi
        ;;
    *)
        echo "usage: sunshine-client-mode {set|restore}" >&2
        exit 2
        ;;
esac

exit 0
