#!/usr/bin/env bash
# Drive the DNS filter's API. The dashboard buttons in .chezmoidata/dashboard.yaml
# call this, so the port stays in .chezmoidata/dns.yaml.
set -euo pipefail

API="http://127.0.0.1:{{ .dns.filter.api_port }}/api"

usage() {
    cat <<'EOF'
usage: blocky <command>

  status            is blocking on, and for how much longer
  stats [n]         totals, share blocked, and the top n domains (default 10)
  pause [duration]  suspend blocking (default 5m)
  resume            re-enable blocking
  blocked [n]       last n blocked queries (default 20)
  why <domain>      which list blocks it, and its recent queries
  refresh           re-download every blocklist
  log [n]           last n query-log lines (default 20)
EOF
}

call() {
    curl -fsS "$@" || { echo "blocky is not answering on $API" >&2; exit 1; }
}

pretty() { python3 -m json.tool 2>/dev/null || cat; }

# The log lives in a podman-owned volume, so ask podman where.
log_dir() {
    local dir
    dir=$(podman volume inspect blocky-data --format '{{ "{{ .Mountpoint }}" }}' 2>/dev/null) || return 1
    [ -d "$dir" ] || return 1
    printf '%s\n' "$dir"
}

# blocky names each file by date, so the last glob match is the newest.
newest_log() {
    local dir logs
    dir=$(log_dir) || return 1
    logs=("$dir"/*.log)
    [ -e "${logs[0]}" ] || return 1
    printf '%s\n' "${logs[-1]}"
}

case "${1:-status}" in
    status)
        call "$API/blocking/status" | pretty
        ;;
    pause)
        call "$API/blocking/disable?duration=${2:-5m}"
        echo "blocking paused for ${2:-5m}"
        ;;
    resume)
        call "$API/blocking/enable"
        echo "blocking on"
        ;;
    refresh)
        call -X POST "$API/lists/refresh"
        echo "blocklists refreshed"
        ;;
    stats)
        dir=$(log_dir) || { echo "no query log yet (has blocky run?)" >&2; exit 1; }
        # Every retained file, not just today: logRetentionDays governs the window.
        awk -F'\t' '{t++; c[$9]++} END{
            printf "  queries   %d\n", t
            printf "  blocked   %d  (%.1f%%)\n", c["BLOCKED"]+0, t ? (c["BLOCKED"]+0)/t*100 : 0
            printf "  resolved  %d\n", c["RESOLVED"]+0
            printf "  cached    %d\n", c["CACHED"]+0
        }' "$dir"/*.log
        echo
        echo "  top blocked:"
        awk -F'\t' '$9=="BLOCKED"{sub(/\.$/,"",$6); c[$6]++} END{for(k in c) printf "%6d  %s\n", c[k], k}' \
            "$dir"/*.log | sort -rn | head -"${2:-10}" | sed 's/^/  /'
        echo
        echo "  denylist entries: $(call "${API%/api}/metrics" |
            awk '/^blocky_denylist_cache_entries/{print $2}')"
        ;;
    blocked)
        log=$(newest_log) || { echo "no query log yet (has blocky run?)" >&2; exit 1; }
        grep -i BLOCKED "$log" | tail -n "${2:-20}" || echo "nothing blocked yet today"
        ;;
    why)
        domain="${2:?usage: blocky why <domain>}"
        call -X POST "$API/query" -H 'Content-Type: application/json' \
             -d "{\"query\":\"$domain\",\"type\":\"A\"}" | pretty
        echo "--- recent queries ---"
        dir=$(log_dir) &&
            grep -h -i -- "$domain" "$dir"/*.log 2>/dev/null | tail -5 ||
            echo "(none in the retained log)"
        ;;
    log)
        log=$(newest_log) || { echo "no query log yet (has blocky run?)" >&2; exit 1; }
        tail -n "${2:-20}" "$log"
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
