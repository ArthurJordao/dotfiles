#!/usr/bin/env bash
# emu-sync-check — report drift in the shared emulation library: sync conflicts
# and emulators installed into the ROM tree. Read-only.
#
# GENERATED — the folder list below is `.syncthing.folders` from
# .chezmoidata/syncthing.yaml.
set -uo pipefail

RED=$'\033[31m'; YELLOW=$'\033[33m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; OFF=$'\033[0m'
[ -t 1 ] || { RED=""; YELLOW=""; GREEN=""; DIM=""; OFF=""; }

issues=0
note() { printf '%s%s%s\n' "$YELLOW" "$1" "$OFF"; issues=$((issues + 1)); }
bad()  { printf '%s%s%s\n' "$RED"    "$1" "$OFF"; issues=$((issues + 1)); }
ok()   { printf '%s%s%s\n' "$GREEN"  "$1" "$OFF"; }

FOLDERS=(
{{- range $f := .syncthing.folders }}
    "{{ $f.id }}|{{ $f.path }}|{{ $f.mode }}"
{{- end }}
)

echo "=== folders ==="
missing=0
for entry in "${FOLDERS[@]}"; do
    IFS='|' read -r id path mode <<< "$entry"
    if [ -d "$HOME/$path" ]; then
        # shellcheck disable=SC2088  # display text, not a path being opened
        printf '  %-22s %-10s %s%s%s\n' "$id" "$mode" "$DIM" "~/$path" "$OFF"
    else
        bad "  $id: ~/$path does not exist — syncthing will not create it"
        missing=$((missing + 1))
    fi
done
[ "$missing" -eq 0 ] && ok "  all ${#FOLDERS[@]} folder paths present"

echo
echo "=== sync conflicts ==="
found=0
for entry in "${FOLDERS[@]}"; do
    IFS='|' read -r id path mode <<< "$entry"
    [ -d "$HOME/$path" ] || continue
    while IFS= read -r f; do
        bad "  $id: ${f#"$HOME"/}"
        found=$((found + 1))
    done < <(find "$HOME/$path" -name '*.sync-conflict-*' -type f 2>/dev/null)
done
[ "$found" -eq 0 ] && ok "  none"

echo
echo "=== .stversions (recoverable old copies) ==="
found=0
for entry in "${FOLDERS[@]}"; do
    IFS='|' read -r id path mode <<< "$entry"
    v="$HOME/$path/.stversions"
    [ -d "$v" ] || continue
    printf '  %-22s %s (%s files)\n' "$id" "$(du -sh "$v" 2>/dev/null | cut -f1)" "$(find "$v" -type f 2>/dev/null | wc -l | tr -d ' ')"
    found=$((found + 1))
done
[ "$found" -eq 0 ] && ok "  none"

echo
echo "=== emulator files inside the ROM tree, not covered by .stignore ==="
# EmuDeck installs emulators into ~/Emulation/roms. Those are per-host and each
# needs a .stignore rule; this flags the ones that have none.
#
# The matcher only approximates Syncthing's pattern rules — a tripwire, not a
# reimplementation.
ROMS="$HOME/Emulation/roms"
IGN="$ROMS/.stignore"

covered() {
    local rel="$1" pat ci base
    while IFS= read -r pat; do
        pat="${pat%%$'\r'}"
        case "$pat" in ''|'//'*|'!'*) continue ;; esac
        ci=0
        case "$pat" in '(?i)'*) ci=1; pat="${pat#'(?i)'}" ;; esac
        if (( ci )); then shopt -s nocasematch; else shopt -u nocasematch; fi
        local hit=1
        case "$pat" in
            /*)
                local p="${pat#/}"
                p="${p%/\*\*}"; p="${p%/\*}"
                # shellcheck disable=SC2053
                if [[ "$rel" == $p || "$rel" == $p/* ]]; then hit=0; fi
                ;;
            */*)
                # shellcheck disable=SC2053
                [[ "$rel" == $pat || "$rel" == */$pat ]] && hit=0
                ;;
            *)
                base="${rel##*/}"
                # shellcheck disable=SC2053
                [[ "$base" == $pat ]] && hit=0
                ;;
        esac
        shopt -u nocasematch
        (( hit == 0 )) && return 0
    done < "$IGN"
    return 1
}

if [ ! -d "$ROMS" ]; then
    bad "  $ROMS missing"
elif [ ! -f "$IGN" ]; then
    bad "  $IGN missing — run 'chezmoi apply'"
else
    found=0; total=0
    while IFS= read -r f; do
        rel="${f#"$ROMS"/}"
        total=$((total + 1))
        covered "$rel" || { note "  $rel"; found=$((found + 1)); }
    done < <(find "$ROMS" \( -iname '*.exe' -o -iname '*.dll' -o -iname '*.AppImage' \
                             -o -iname '*.sh' -o -iname '*.lua' -o -iname '*.pat' \) -type f 2>/dev/null | sort)
    if [ "$found" -eq 0 ]; then
        ok "  none ($total emulator files, all covered by .stignore)"
    else
        printf '%s  ^ %d of %d not covered — add rules to ~/Emulation/roms/.stignore%s\n' "$DIM" "$found" "$total" "$OFF"
    fi
fi

echo
echo "=== syncthing state ==="
if ! systemctl --user is-active --quiet syncthing.service; then
    bad "  syncthing.service is not running"
elif command -v syncthing >/dev/null 2>&1; then
    ok "  syncthing.service running"
    # Per-folder state comes from the REST API: there is no `cli show folder`.
    APIKEY=$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$HOME/.local/state/syncthing/config.xml" 2>/dev/null)
    if [ -z "$APIKEY" ]; then
        note "  no apikey in config.xml yet — skipping folder status"
    else
        python3 - "$APIKEY" "${FOLDERS[@]}" <<'PY' || note "  ^ folders above need attention"
import sys, json, urllib.request
key, entries = sys.argv[1], sys.argv[2:]
def api(p):
    r = urllib.request.Request("http://127.0.0.1:8384" + p, headers={"X-API-Key": key})
    return json.load(urllib.request.urlopen(r, timeout=10))
need_total = 0
problems = 0
for e in entries:
    fid = e.split("|")[0]
    try:
        s = api("/rest/db/status?folder=" + fid)
    except Exception:
        print(f"  {fid:22s} unknown to syncthing (declared in the repo but not applied here)")
        problems += 1
        continue
    g, n, st = s.get("globalBytes", 0), s.get("needBytes", 0), s.get("state", "?")
    need_total += n
    pct = 100 * (g - n) / g if g else 100.0
    err = s.get("errors", 0)
    okish = (n == 0 and st == "idle" and not err)
    if not okish:
        problems += 1
    flag = "" if okish else "   <--"
    print(f"  {fid:22s} {st:12s} {pct:5.1f}%  {g/2**30:6.2f} GB" + (f"  errors={err}" if err else "") + flag)
print(f"  {'TOTAL':22s} {'':12s}        remaining {need_total/2**30:.2f} GB")
sys.exit(1 if problems else 0)
PY
    fi
else
    bad "  syncthing binary not found — run 'just packages'"
fi

echo
if [ "$issues" -eq 0 ]; then
    ok "No issues."
else
    printf '%s%d thing(s) worth a look.%s\n' "$YELLOW" "$issues" "$OFF"
fi
