{{- /* Which tiles the dashboards show, in what order. One source for OliveTin
       and homepage both: a group renders only if something in it has a port,
       and a ported endpoint in no group lands in "Other", so a new service
       cannot go missing from one dashboard while appearing in the other.

       Emits JSON -- the caller does `| fromJson`. Groups come out in sorted
       key order, tiles alphabetically within a group. */ -}}
{{- /* `web: false` marks a port that is not a browser UI -- linking to it
       would present a 404 as a service. Read with hasKey, never `| default`:
       sprig treats false as empty and would flip it back to true. */ -}}
{{- $ported := dict -}}
{{- range $hostname, $host := .hosts -}}
{{- range (index $host "endpoints" | default list) -}}
{{- $web := true -}}
{{- if hasKey . "web" }}{{ $web = .web }}{{ end -}}
{{- if and (hasKey . "port") $web }}{{ $_ := set $ported .name true }}{{ end -}}
{{- end -}}
{{- end -}}
{{- /* Only this host's services have a local status probe behind them. A tile
       for one on another host still links. */ -}}
{{- $local := dict -}}
{{- range (index (index .hosts .hostname) "endpoints" | default list) -}}
{{- if hasKey $ported .name }}{{ $_ := set $local .name true }}{{ end -}}
{{- end -}}
{{- $groups := list -}}
{{- $tiled := dict -}}
{{- range $group, $members := .tiles -}}
{{- $shown := list -}}
{{- range $name, $tile := $members -}}
{{- $_ := set $tiled $name true -}}
{{- if hasKey $ported $name -}}
{{- $shown = append $shown (dict
      "name" $name
      "label" (index $tile "label" | default $name)
      "description" (index $tile "description" | default "")
      "icon" (index $tile "icon" | default "")
      "container" (index $tile "container" | default "")
      "local" (hasKey $local $name)) -}}
{{- end -}}
{{- end -}}
{{- if $shown -}}
{{- $groups = append $groups (dict "name" $group "other" false "tiles" $shown) -}}
{{- end -}}
{{- end -}}
{{- $other := list -}}
{{- range $name := (keys $ported | sortAlpha) -}}
{{- if not (hasKey $tiled $name) -}}
{{- $other = append $other (dict
      "name" $name "label" $name "description" "" "icon" "" "container" ""
      "local" (hasKey $local $name)) -}}
{{- end -}}
{{- end -}}
{{- if $other -}}
{{- $groups = append $groups (dict "name" "Other" "other" true "tiles" $other) -}}
{{- end -}}
{{- dict "groups" $groups | toJson -}}
