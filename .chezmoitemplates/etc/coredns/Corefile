{{- $domain := .domain -}}
{{- /* A proxied name must resolve to whoever runs Caddy, not to whoever runs the
       service -- otherwise moving `edge` sends every client past the edge to a
       host with nothing on 443. Portless endpoints are the opposite: they are
       reached on their own TCP port and must stay on their service host.
       check-consistency C18 guarantees exactly one host carries the role. */ -}}
{{- $edgeLan := "" -}}
{{- $edgeTs := "" -}}
{{- range $host := .hosts -}}
{{-   if has "edge" (index $host "roles" | default list) -}}
{{-     $ip := index $host "ip" | default dict -}}
{{-     $edgeLan = index $ip "lan" -}}
{{-     $edgeTs = index $ip "tailscale" -}}
{{-   end -}}
{{- end -}}
{{- /* The filter hop is emitted only where blocky runs -- otherwise every
       query would pay a failover to a dead port. */ -}}
{{- $filter := "" -}}
{{- if has "blocky" (index (index .hosts .hostname) "quadlets" | default list) -}}
{{-   $filter = printf "127.0.0.1:%v " .dns.filter.port -}}
{{- end -}}
# GENERATED from .chezmoidata/hosts.yaml — edit the endpoints there, not this file.

{{/* policy sequential is load-bearing: forward's default is `random`, which
     would send half of all queries around the filter. */}}
(upstream) {
    forward . {{ $filter }}{{ range .dns.upstream.ips }}tls://{{ . }} {{ end }}{
        policy sequential
        tls_servername {{ .dns.upstream.servername }}
    }
}

(local_hosts) {
    hosts {
{{- range $hostname, $host := .hosts }}
{{- if index $host "ip" }}
        {{ $host.ip.lan }} {{ $hostname }}.{{ $domain }}
{{- range (index $host "endpoints" | default list) }}
        {{ if hasKey . "port" }}{{ $edgeLan }}{{ else }}{{ $host.ip.lan }}{{ end }} {{ .name }}.{{ $domain }}
{{- end }}
{{- end }}
{{- end }}
        fallthrough
    }
}

(tailscale_hosts) {
    hosts {
{{- range $hostname, $host := .hosts }}
{{- if index $host "ip" }}
        {{ $host.ip.tailscale }} {{ $hostname }}.{{ $domain }}
{{- range (index $host "endpoints" | default list) }}
        {{ if hasKey . "port" }}{{ $edgeTs }}{{ else }}{{ $host.ip.tailscale }}{{ end }} {{ .name }}.{{ $domain }}
{{- end }}
{{- end }}
{{- end }}
        fallthrough
    }
}

{{/* Reverse (PTR) zones, one per /24 that any declared host address falls in.

     Without these, a PTR for a private address falls through to `forward .
     tls://1.1.1.1`, which cannot answer RFC1918 or CGNAT space. Queried
     directly, CoreDNS now answers NXDOMAIN in 8ms instead of forwarding, and
     LAN addressing stops being leaked upstream.

     NOTE ON SCOPE: this was originally written believing it explained mars
     becoming unreachable over SSH. It does not. `getent`/`resolvectl` on mars
     still take ~7.5s for a private PTR *after* this change, because the delay
     is in systemd-resolved on wlan0 (which has both 192.168.15.23 and 1.1.1.1
     configured, and answers slowly even though dig against either is fast) —
     not in CoreDNS. And SSH connects in ~300ms while resolved is still slow,
     which proves sshd was never doing the reverse lookup. The SSH outages
     correlated with heavy syncthing load; the mechanism is still unknown.

     `template` returning NXDOMAIN, not `hosts`: the hosts plugin does not
     synthesize PTRs from inline entries here, and with no `fallthrough` and no
     plugin after it, it answers SERVFAIL ("no next plugin found") — verified
     against a throwaway CoreDNS on port 15353. Nor can the two be combined:
     CoreDNS orders plugins by its own plugin.cfg, where `template` precedes
     `hosts`, so a template fallback would shadow any hosts entries.

     Fast failure is the whole point — nothing on this network needs reverse DNS
     to succeed, it just must not cost a 7.7s upstream timeout. */}}
{{- $rev := dict -}}
{{- range $hostname, $host := .hosts -}}
{{-   $ip := index $host "ip" | default dict -}}
{{-   range $kind := list "lan" "tailscale" -}}
{{-     if index $ip $kind -}}
{{-       $o := splitList "." (index $ip $kind) -}}
{{-       $_ := set $rev (printf "%s.%s.%s.in-addr.arpa" (index $o 2) (index $o 1) (index $o 0)) true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{ range $zone, $_ := $rev }}
{{ $zone }}:53 {
    template IN PTR {
        rcode NXDOMAIN
    }
    errors
}
{{ end }}
.:53 {
    view local {
        expr incidr(client_ip(), '192.168.15.0/24') || incidr(client_ip(), '127.0.0.1/32')
    }
    import local_hosts
    import upstream
    cache
    log
    errors
}

.:53 {
    view tailscale {
        expr incidr(client_ip(), '100.64.0.0/10')
    }
    import tailscale_hosts
    import upstream
    cache
    log
    errors
}

.:53 {
    import upstream
    cache
    log
    errors
}

https://.:8053 {
    tls /etc/coredns/cert.pem /etc/coredns/key.pem
    proxyproto
    view local {
        expr incidr(client_ip(), '192.168.15.0/24') || incidr(client_ip(), '127.0.0.1/32') || incidr(client_ip(), '::1/128')
    }
    import local_hosts
    import upstream
    cache
    errors
}

https://.:8053 {
    tls /etc/coredns/cert.pem /etc/coredns/key.pem
    proxyproto
    view tailscale {
        expr incidr(client_ip(), '100.64.0.0/10')
    }
    import tailscale_hosts
    import upstream
    cache
