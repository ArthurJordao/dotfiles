{{- /* The tunnel's credentials, from 1Password rather than living only on the
       edge host. Losing that one file used to cost the tunnel identity:
       recovery mints a new ID, which then has to be written back into
       .chezmoidata/cloudflare.yaml with every public CNAME recreated.

       Endpoint is empty in the file cloudflared writes; reproduced so the JSON
       matches what the tool expects. */ -}}
{{- $s := includeTemplate "secret-coords" (dict "secrets" .secrets "key" "cloudflared") | fromJson -}}
{{- $op := onepasswordItemFields $s.item $s.vault -}}
{"AccountTag":"{{ (index $op "ACCOUNT_TAG").value }}","TunnelSecret":"{{ (index $op "TUNNEL_SECRET").value }}","TunnelID":"{{ .cloudflare.tunnel_id }}","Endpoint":""}
