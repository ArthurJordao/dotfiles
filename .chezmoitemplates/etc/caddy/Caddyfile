{{- $domain := .domain -}}
{{- $edge := .hostname -}}
# GENERATED from .chezmoidata/hosts.yaml — edit the endpoints there, not this file.
#
# Upstreams use 127.0.0.1, never localhost: localhost resolves to ::1 first,
# and rootless pasta containers forward IPv4 only — the connection is accepted
# then dropped, and Caddy returns a 502 without falling back.
{{ range $hostname, $host := .hosts }}
{{- range (index $host "endpoints" | default list) }}
{{- if hasKey . "port" }}
{{- /* endpoint served by this same box -> loopback; by another host -> its LAN IP */ -}}
{{- $upstream := $host.ip.lan }}{{ if eq $hostname $edge }}{{ $upstream = "127.0.0.1" }}{{ end }}
{{- $scheme := index . "scheme" | default "http" }}
{{- $log := true }}{{ if hasKey . "log" }}{{ $log = .log }}{{ end }}
{{- $auth := index . "auth" | default "" }}
{{- /* Hyphens are legal in an endpoint name and illegal in an env var name. */ -}}
{{- $token := printf "%s_BEARER_TOKEN" (upper (replace "-" "_" .name)) }}
{{ .name }}.{{ $domain }} {
{{- if eq $auth "bearer" }}
    # {$VAR} is substituted before the Caddyfile is parsed; the runtime
    # {env.VAR} form is not expanded inside a matcher. `respond` sorts ahead of
    # `reverse_proxy` in the default directive order, so no `route` wrapper.
    @unauth not header Authorization "Bearer {${{ $token }}}"
    respond @unauth 401
{{- end }}
    reverse_proxy {{ if eq $scheme "https" }}https://{{ end }}{{ $upstream }}:{{ .port }}{{ if index . "tls_insecure" | default false }} {
        transport http {
            tls_insecure_skip_verify
        }
    }{{ end }}

    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
{{- if $log }}
    log {
        output file /var/log/caddy/{{ .name }}-access.log
        format json
    }
{{- end }}
}
{{ end }}{{ end }}{{ end -}}
