{{- $s := index .secrets.items "caddy" -}}
{{- $op := onepasswordItemFields $s.item_name $s.vault -}}
CF_API_TOKEN={{ (index $op "CF_API_TOKEN").value }}
{{- /* One line per `auth: bearer` endpoint; the Caddyfile reads it as {$VAR}.
       Hyphens are legal in an endpoint name and illegal in an env var name. */ -}}
{{- range $hostname, $host := .hosts -}}
{{- range (index $host "endpoints" | default list) -}}
{{- if eq (index . "auth" | default "") "bearer" -}}
{{- $token := printf "%s_BEARER_TOKEN" (upper (replace "-" "_" .name)) }}
{{ $token }}={{ (index $op $token).value }}
{{- end -}}
{{- end -}}
{{- end }}
