{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "theme",
  "type": "object",
  "required": ["theme"],
  "properties": {
    "theme": {
      "type": "object",
      "required": ["active", "homepage"],
      "properties": {
        "active": {
          "type": "string",
          "description": "Key of the theme block below. The single switch."
        },
        "homepage": {
          "type": "object",
          "description": "The dashboard's own light/dark and palette name. Deliberately not per-theme: homepage cannot take hex, so nothing about it follows from `active`.",
          "required": ["theme", "color"],
          "additionalProperties": false,
          "properties": {
            "theme": {"enum": ["light", "dark"]},
            "color": {
              "description": "One of homepage's built-in palette names; anything else falls back to slate.",
              "enum": ["slate", "gray", "zinc", "neutral", "stone", "amber", "yellow",
                     "lime", "green", "emerald", "teal", "cyan", "sky", "blue",
                     "indigo", "violet", "purple", "fuchsia", "pink", "rose", "red", "white"]
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["palette", "vivid", "fish", "bat", "wezterm", "nvim"],
        "additionalProperties": false,
        "properties": {
          "palette": {
            "type": "string",
            "description": "Key into palettes.yaml. Drives FZF and lazygit."
          },
          "vivid": {"type": "string"},
          "fish": {
            "type": "string",
            "description": "Must match a vendored .theme file, or fish falls back silently."
          },
          "bat": {
            "type": "string",
            "description": "A theme bat ships built in; see `bat --list-themes`. An unknown name warns and falls back to a dark default."
          },
          "wezterm": {
            "type": "string",
            "description": "A wezterm built-in color scheme name."
          },
          "nvim": {
            "type": "object",
            "required": ["plugin", "name", "colorscheme", "opts"],
            "additionalProperties": false,
            "properties": {
              "plugin": {"type": "string"},
              "name": {"type": "string"},
              "colorscheme": {"type": "string"},
              "opts": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
