{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "palettes.yaml",
  "description": "GENERATED by tools/fetch-palette. base16 palettes; only FZF and lazygit read them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "palettes"
  ],
  "properties": {
    "palettes": {
      "type": "object",
      "description": "Keyed by palette name. `theme.<name>.palette` in theme.yaml names one of these.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "base00",
          "base01",
          "base02",
          "base03",
          "base04",
          "base05",
          "base06",
          "base07",
          "base08",
          "base09",
          "base0A",
          "base0B",
          "base0C",
          "base0D",
          "base0E",
          "base0F"
        ],
        "properties": {
          "source": {
            "type": "string",
            "format": "uri",
            "description": "Upstream the palette was fetched from. Re-running tools/fetch-palette with this URL reproduces the entry.",
            "pattern": "^https://"
          }
        },
        "patternProperties": {
          "^base0[0-9A-F]$": {
            "type": "string",
            "description": "base16 slot. All 16 are required — a missing one renders an empty color into the FZF and lazygit configs.",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        }
      }
    }
  }
}
