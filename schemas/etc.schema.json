{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etc",
  "type": "object",
  "required": ["etc"],
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["src", "dest", "mode"],
            "properties": {
              "src": {
                "type": "string",
                "description": "Path under .chezmoitemplates/etc/, inlined into the deploy script.",
                "minLength": 1
              },
              "dest": {
                "type": "string",
                "description": "Absolute destination. May contain {tunnel_id}, substituted at render time.",
                "pattern": "^/etc/"
              },
              "mode": {
                "type": "string",
                "description": "Octal mode passed to install(1).",
                "pattern": "^[0-7]{3,4}$"
              }
            }
          }
        },
        "enable":  {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true,
                    "description": "Units to `systemctl enable --now` after installing."},
        "reload":  {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true,
                    "description": "Units to reload, falling back to restart."},
        "restart": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true,
                    "description": "Units to restart outright."}
      }
    }
  },
  "properties": {
    "etc": {
      "type": "object",
      "description": "Files installed under /etc, in two namespaces.",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "object",
          "description": "Groups keyed by the role that owns them. A key matching none of a host's roles installs nothing. Must not name a role any darwin host carries.",
          "additionalProperties": {"$ref": "#/$defs/group"}
        },
        "hosts": {
          "type": "object",
          "description": "Groups keyed by hostname, for a file about one box only -- hardware, a distro quirk. Never a purpose; that belongs in roles.",
          "additionalProperties": {"$ref": "#/$defs/group"}
        }
      }
    }
  }
}
