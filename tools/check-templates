#!/usr/bin/env bash
# Render every template for every host and report any that fail.
#
#   tools/check-templates
#
# Catches what `simulate-host <host> managed` does not: a stale `include` or
# path reference. `managed` only lists target paths, so a broken include inside
# a run_onchange script passes it and blows up during a real apply.
#
# 1Password calls go to tools/mock-op, so no template has to be skipped.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
HOSTS=$(./tools/hosts)

fail=0 n=0
for h in $HOSTS; do
    for t in $(git ls-files --cached --others --exclude-standard | grep -E '\.tmpl$'); do
        n=$((n + 1))
        if ! out=$(./tools/simulate-host "$h" execute-template < "$t" 2>&1 >/dev/null); then
            printf 'FAIL %-9s %s\n' "$h" "$t"
            printf '     %s\n' "$(echo "$out" | head -2)"
            fail=1
        fi
    done
    # The /etc bodies live in .chezmoitemplates, so they have no .tmpl to feed
    # in. They are only reached through the edge host's deploy script otherwise.
    for e in $(./tools/render-edge --list); do
        n=$((n + 1))
        if ! out=$(./tools/render-edge "$h" "$e" 2>&1 >/dev/null); then
            printf 'FAIL %-9s %s\n' "$h" ".chezmoitemplates/etc/$e"
            printf '     %s\n' "$(echo "$out" | head -2)"
            fail=1
        fi
    done
done

if [ "$fail" -eq 0 ]; then
    echo "ok: $n renders across $(echo "$HOSTS" | wc -w | tr -d ' ') hosts"
else
    echo "FAILURES above" >&2
fi
exit "$fail"
