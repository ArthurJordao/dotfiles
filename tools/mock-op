#!/usr/bin/env bash
# Stand in for the `op` binary so a simulated render needs no 1Password session.
#
#   tools/mock-op item get --format json <item> --vault <vault>
#
# Wired in by tools/simulate-host as `[onepassword] command`. chezmoi puts
# `--session <token>` BEFORE the subcommand, so scan argv rather than read $1.
#
# Field names are harvested from the templates themselves: over-inclusive on
# purpose, since a spare field costs nothing and a missing one fails the render.
# .chezmoitemplates needs its own pass -- its entries have no .tmpl extension.
# A field name looked up dynamically (`index $op $user.secret`) never appears
# as a literal in a template, so its name is harvested from the `secret:`
# values in .chezmoidata/*.yaml instead. Same for caddy.env's per-endpoint
# <NAME>_BEARER_TOKEN, derived from an `auth: bearer` endpoint's own name.
# The harvested pool is global, not scoped per item -- a template that ranges
# over one item's fields (secrets.fish.tmpl over `shell`) sees every field name
# harvested from every source, including other items'.
# Every field needs a `section` -- onepasswordItemFields drops the ones without,
# leaving an empty map and `no entry for key "value"` at every lookup.
# A field whose value must parse as something -- `trust`, mapped to a number by
# .chezmoitemplates/gpg-trust -- gets a real value instead of a mock: prefix, or
# the render fails on the placeholder.
# A real login item's password/username/notesPlain carry no section (and a
# `purpose` instead) -- onepasswordDetailsFields is the mirror image, keeping
# only section-less fields keyed by id. Modeled here for those three ids: no
# section, plus the purpose a real item would carry.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

for arg in "$@"; do
    case "$arg" in
        signin)
            echo "mock-session"
            exit 0 ;;
        read)
            echo "mock-secret"
            exit 0 ;;
        --version)
            echo "0.0.0-mock"
            exit 0 ;;
        document)
            # onepasswordDocument inlines a document's bytes at render time. Only
            # public keys go through it, so a stand-in armored block is enough.
            printf -- '-----BEGIN PGP PUBLIC KEY BLOCK-----\n\nmock\n-----END PGP PUBLIC KEY BLOCK-----\n'
            exit 0 ;;
        item)
            { grep -rhoE 'index \$[a-zA-Z]+ "[^"]+"' --include='*.tmpl' . ;
              grep -rhoE 'index \$[a-zA-Z]+ "[^"]+"' .chezmoitemplates ;
              grep -rhoE 'secret: [A-Za-z0-9_]+' .chezmoidata | sed 's/secret: //' ;
              grep -rhoE '\{name: [a-z0-9-]+,[^}]*auth: bearer' .chezmoidata \
                | sed -E 's/\{name: ([a-z0-9-]+).*/\1_BEARER_TOKEN/' | tr 'a-z-' 'A-Z_' ; } \
                | sed 's/.*"\(.*\)"/\1/' | sort -u \
                | awk 'BEGIN { printf "{\"fields\":[" }
                       { section = "\"section\":{\"id\":\"mock\"},"; purpose = ""; value = "mock:" $0
                         if ($0 == "trust") { value = "full" }
                         if ($0 == "password") { section = ""; purpose = ",\"purpose\":\"PASSWORD\"" }
                         else if ($0 == "username") { section = ""; purpose = ",\"purpose\":\"USERNAME\"" }
                         else if ($0 == "notesPlain") { section = ""; purpose = ",\"purpose\":\"NOTES\"" }
                         printf "%s{\"id\":\"%s\",\"label\":\"%s\",\"type\":\"STRING\",%s\"value\":\"%s\"%s}", sep, $0, $0, section, value, purpose; sep = "," }
                       END { print "]}" }'
            exit 0 ;;
    esac
done

echo "mock-op: unmocked call: $*" >&2
exit 1
