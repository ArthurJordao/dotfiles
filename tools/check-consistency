#!/usr/bin/env python3
"""Cross-reference hosts.yaml's flat lists against what the repo contains.

    tools/check-consistency

quadlets / units / endpoints are independent lists and nothing errors when they
disagree: a quadlet with no `units` entry keeps running through gaming mode, a
`units` entry with no quadlet names a unit that will never exist, an endpoint
with no quadlet is a 502. This is what makes each of those fail.

Data comes from chezmoi itself rather than a YAML parser -- neither macOS nor a
bare CI runner ships one, and this way the checker sees exactly what chezmoi
merged.
"""

import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
QUADLETS = os.path.join(ROOT, "dot_config/containers/exact_systemd")
USER_UNITS = os.path.join(ROOT, "dot_config/systemd/user")
SIMULATE = os.path.join(ROOT, "tools/simulate-host")

# Suffix podman appends to the unit a quadlet file generates.
GENERATES = {".container": "", ".pod": "-pod", ".network": "-network", ".volume": "-volume"}
# Only these belong in `units` -- nothing should be stopping a network unit.
STOPPABLE = {".container", ".pod"}


def render(host, text=None, path=None):
    src = text if path is None else open(path).read()
    proc = subprocess.run([SIMULATE, host, "execute-template"],
                          input=src, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.exit("render failed for %s on %s:\n%s" % (path or "<inline>", host, proc.stderr))
    return proc.stdout


def quadlet_files():
    out = []
    for dirpath, _, names in os.walk(QUADLETS):
        for name in names:
            out.append(os.path.relpath(os.path.join(dirpath, name), QUADLETS))
    return sorted(out)


def generated_unit(rel):
    """(unit name, quadlet extension) a file generates, or None if it makes no unit."""
    base = rel[:-len(".tmpl")] if rel.endswith(".tmpl") else rel
    stem, ext = os.path.splitext(os.path.basename(base))
    if ext not in GENERATES:
        return None
    return stem + GENERATES[ext], ext


def target_name(entry):
    """Strip the chezmoi source attributes, since `quadlets` names the target."""
    for attr in ("exact_", "private_"):
        if entry.startswith(attr):
            return target_name(entry[len(attr):])
    return entry


def claims(entry, quadlet):
    """Whether a `quadlets` entry names this top-level entry under systemd/.

    An entry is a directory (`immich`) or the stem before the first dot
    (`immich.pod`, `cloudflare-ddns.env.tmpl`). Not a prefix test: .chezmoiignore
    emits one host's names to suppress them on the others, and a prefix would let
    `shelf` swallow another host's `shelfmark`.
    """
    name = target_name(entry)
    return name == quadlet or name.startswith(quadlet + ".")


failures = []


def fail(rule, msg):
    failures.append("%s %s" % (rule, msg))


data = json.loads(render("_checker", text=(
    '{{ dict "hosts" .hosts "packages" .packages "syncthing" .syncthing '
    '"minecraft" .minecraft "dashboard" .dashboard "secrets" .secrets | toJson }}')))
hosts = data["hosts"]
packages = data.get("packages") or {}
folders = (data.get("syncthing") or {}).get("folders") or []
instances = (data.get("minecraft") or {}).get("instances") or []
dashboard = data.get("dashboard") or {}
# Item titles only -- no secret value is ever read here.
secrets = data.get("secrets") or {}

files = quadlet_files()
top_level = set(f.split(os.sep)[0] for f in files)


for name in sorted(hosts):
    host = hosts[name]
    # An unmanaged host declares nothing but user/ip -- every rule below is
    # about state chezmoi deploys, and it deploys none.
    if host.get("managed") is False:
        continue
    quadlets = host.get("quadlets") or []
    # Every entry is {name, stop_for_gaming?}; only the name concerns these rules.
    units = [u["name"] for u in host.get("units") or []]
    endpoints = host.get("endpoints") or []
    roles = host.get("roles") or []

    # .chezmoiignore suppresses every *other* host's quadlets, so this host
    # receives whatever its own names claim.
    deployed = [f for f in files
                if any(claims(f.split(os.sep)[0], q) for q in quadlets)]

    # C1 -- a name matching nothing deploys nothing, with no error.
    for quadlet in quadlets:
        if not any(claims(t, quadlet) for t in top_level):
            fail("C1", "%s: quadlet name %r matches no file under "
                       "dot_config/containers/exact_systemd/" % (name, quadlet))

    # C2 -- a container missing from `units` keeps running through gaming mode.
    for f in deployed:
        made = generated_unit(f)
        if made and made[1] == ".container" and made[0] not in units:
            fail("C2", "%s: %s generates %s.service, missing from `units`"
                       % (name, f, made[0]))

    # C3 -- a `units` entry naming a unit that will never exist.
    declared_packages = set()
    family = packages.get(host.get("distro") or "") or {}
    for group in ["common"] + roles:
        for pkg in family.get(group) or []:
            declared_packages.add(pkg if isinstance(pkg, str) else pkg.get("name"))
    generated = set(generated_unit(f)[0] for f in deployed if generated_unit(f))
    for unit in units:
        if unit in generated:
            continue
        # A templated instance (minecraft@vanilla) comes from minecraft@.service.
        stem = unit.split("@")[0] + "@" if "@" in unit else unit
        if any(os.path.exists(os.path.join(USER_UNITS, stem + suffix))
               for suffix in (".service", ".service.tmpl", ".timer", ".timer.tmpl")):
            continue
        # A package can ship the unit -- syncthing's comes from the package the
        # emulation role declares.
        if unit in declared_packages:
            continue
        fail("C3", "%s: `units` entry %r is generated by no quadlet, is no file "
                   "in dot_config/systemd/user/, and is no declared package"
                   % (name, unit))

    # C4 -- an endpoint nothing listens on is a 502.
    published = set()
    for f in deployed:
        made = generated_unit(f)
        if not made or made[1] not in STOPPABLE:
            continue
        path = os.path.join(QUADLETS, f)
        text = render(name, path=path) if f.endswith(".tmpl") else open(path).read()
        for match in re.finditer(r"^PublishPort=(?:[\d.]+:)?(\d+):", text, re.M):
            published.add(int(match.group(1)))
    for endpoint in endpoints:
        if "port" not in endpoint or endpoint.get("served_by"):
            continue
        if int(endpoint["port"]) not in published:
            fail("C4", "%s: endpoint %r port %s is published by no quadlet "
                       "(add `served_by:` if a non-container service listens there)"
                       % (name, endpoint["name"], endpoint["port"]))

    # C17 -- `auth` on a portless endpoint guards nothing: no port means no
    # Caddy block, and the guard lives in that block.
    for endpoint in endpoints:
        if endpoint.get("auth") and "port" not in endpoint:
            fail("C17", "%s: endpoint %r sets `auth` but declares no port -- it "
                        "emits no Caddy block, so nothing checks the token"
                        % (name, endpoint["name"]))

# C18 -- the Corefile points every proxied name at the edge host's IP, so exactly
# one managed host must carry the role, and it must declare an address.
edge_hosts = [n for n, h in hosts.items()
              if h.get("managed") is not False and "edge" in (h.get("roles") or [])]
if len(edge_hosts) != 1:
    fail("C18", "%d hosts declare the `edge` role (%s) -- the Corefile resolves every "
                "proxied name to the edge host, so exactly one must carry it"
                % (len(edge_hosts), ", ".join(sorted(edge_hosts)) or "none"))
elif not (hosts[edge_hosts[0]].get("ip") or {}).get("lan"):
    fail("C18", "%s carries the `edge` role but declares no `ip` -- every proxied name "
                "would resolve to an empty address" % edge_hosts[0])

# C5 -- a oneway folder whose source host does not even run syncthing.
for folder in folders:
    source = folder.get("source")
    if not source:
        continue
    if source not in hosts:
        fail("C5", "syncthing folder %r: source %r is not a host"
                   % (folder["id"], source))
    elif "emulation" not in (hosts[source].get("roles") or []):
        fail("C5", "syncthing folder %r: source %r lacks the emulation role"
                   % (folder["id"], source))

# C6 -- a package group keyed on a role nothing declares installs nothing.
all_roles = set(r for h in hosts.values() for r in (h.get("roles") or []))
for family in ("arch", "debian"):
    for key in sorted(packages.get(family) or {}):
        if key != "common" and key not in all_roles:
            fail("C6", "packages.%s.%s is not a role any host declares"
                       % (family, key))

# C16 -- an `except` naming no host excludes nothing, silently.
# Membership, not the emulation role: a host is listed here before it gains
# the role, which is how it is kept out of a folder from the start.
for folder in folders:
    for name in folder.get("except") or []:
        if name not in hosts:
            fail("C16", "syncthing folder %r: except %r is not a host"
                        % (folder["id"], name))

# C7 -- an instance whose JDK package is not declared installs no JVM to run on.
for name in sorted(hosts):
    host = hosts[name]
    roles = host.get("roles") or []
    if "minecraft" not in roles:
        continue
    family = packages.get(host.get("distro") or "") or {}
    declared = set()
    for group in ["common"] + roles:
        for pkg in family.get(group) or []:
            declared.add(pkg if isinstance(pkg, str) else pkg.get("name"))
    for inst in instances:
        pkg = "jdk%s-openjdk" % inst["jdk"]
        if pkg not in declared:
            fail("C7", "%s: instance %r needs %s, absent from "
                       "packages.arch.minecraft" % (name, inst["name"], pkg))

# C8 -- a `ddns: true` endpoint with no cloudflare-ddns quadlet never updates.
ddns_names = [e["name"] for h in hosts.values()
              for e in (h.get("endpoints") or []) if e.get("ddns")]
if ddns_names:
    if not any("cloudflare-ddns" in (h.get("quadlets") or [])
               for h in hosts.values()):
        fail("C8", "endpoints %s set `ddns: true` but no host deploys the "
                   "cloudflare-ddns quadlet" % ", ".join(sorted(ddns_names)))

# C9 -- an endpoint named after a host emits that name twice in the Corefile.
for name in sorted(hosts):
    for endpoint in hosts[name].get("endpoints") or []:
        if endpoint["name"] in hosts:
            fail("C9", "%s: endpoint %r collides with the host of that name -- "
                       "both emit <name>.<domain> in the Corefile and an ssh alias"
                       % (name, endpoint["name"]))

# C10 -- a `managed: false` host declaring state nothing will ever deploy.
DEPLOY_FIELDS = ["roles", "os", "distro", "quadlets", "units", "endpoints",
                 "storage", "syncthing_id"]
for name in sorted(hosts):
    host = hosts[name]
    if host.get("managed") is not False:
        continue
    declared = [f for f in DEPLOY_FIELDS if f in host]
    if declared:
        fail("C10", "%s: `managed: false` but declares %s -- chezmoi never runs "
                    "there, so it is inert" % (name, ", ".join(declared)))

# C11 -- a file no host claims. .chezmoiignore suppresses the *other* hosts'
# quadlets by name, so anything unclaimed is unignored everywhere: it deploys to
# every host with the podman role and starts at the next boot.
claimed = set(q for h in hosts.values() for q in (h.get("quadlets") or []))
for entry in sorted(top_level):
    if not any(claims(entry, q) for q in claimed):
        fail("C11", "dot_config/containers/exact_systemd/%s is in no host's "
                    "`quadlets` -- it deploys to every podman host" % entry)

# C12 -- a tile keyed on nothing: an endpoint that was renamed or removed
# leaves its presentation behind, and the tile silently stops rendering.
endpoint_names = set(e["name"] for h in hosts.values()
                     for e in (h.get("endpoints") or []))
for group, members in sorted((dashboard.get("tiles") or {}).items()):
    for tile in sorted(members or {}):
        if tile not in endpoint_names:
            fail("C12", "dashboard.tiles[%r][%r] names no endpoint in hosts.yaml"
                        % (group, tile))

# C19 -- a tile on a `web: false` endpoint renders on no dashboard. The tile is
# not wrong, it is unreachable, and nothing else would say so.
non_web = set(e["name"] for h in hosts.values()
              for e in (h.get("endpoints") or []) if e.get("web") is False)
for group, members in sorted((dashboard.get("tiles") or {}).items()):
    for tile in sorted(members or {}):
        if tile in non_web:
            fail("C19", "dashboard.tiles[%r][%r] names an endpoint marked "
                        "`web: false` -- no dashboard renders it" % (group, tile))

# C20 -- a widget whose credentials name an item that does not exist renders
# HOMEPAGE_VAR_* lines the apply cannot fill.
for group, members in sorted((dashboard.get("tiles") or {}).items()):
    for tile, spec in sorted((members or {}).items()):
        item = ((spec or {}).get("widget") or {}).get("item")
        if item and item not in (secrets.get("items") or {}):
            fail("C20", "dashboard.tiles[%r][%r] widget reads item %r, which is "
                        "not in secrets.items" % (group, tile, item))

# C13 -- OliveTin identifies an action by its title, so a duplicate makes one
# of them unreachable rather than erroring.
seen = set()
all_actions = [a for group in (dashboard.get("actions") or {}).values() for a in group]
for action in all_actions:
    title = action.get("title")
    if title in seen:
        fail("C13", "dashboard.actions has two actions titled %r -- OliveTin "
                    "keys on the title" % title)
    seen.add(title)

# C14 -- an action gated on a role no host declares is dead config.
for action in all_actions:
    role = action.get("role")
    if role and role not in all_roles:
        fail("C14", "dashboard.actions[%r] is gated on role %r, which no host "
                    "declares" % (action.get("title"), role))

# C15 -- a status block keyed on a group that has no buttons renders nowhere:
# the Controls dashboard builds its fieldsets from `actions`.
for group in sorted(dashboard.get("status") or {}):
    if group not in (dashboard.get("actions") or {}):
        fail("C15", "dashboard.status[%r] names no group in dashboard.actions "
                    "-- the status line renders nowhere" % group)

if failures:
    for line in failures:
        print(line)
    print("\n%d consistency failures" % len(failures), file=sys.stderr)
    sys.exit(1)
print("ok: %d hosts consistent with %d quadlet files" % (len(hosts), len(files)))
