#!/usr/bin/env python3
"""Fetch a base16 scheme, normalize it, merge it into .chezmoidata/palettes.yaml.

    tools/fetch-palette <name> <url>

Upstreams disagree on shape -- tinted-theming nests under `palette:` and writes
"#rrggbb"; edunfelt is flat and writes "rrggbb". A flat regex handles both.
No PyYAML: it is not installed, and this repo avoids the dependency.
"""

import re
import subprocess
import sys
from pathlib import Path

SLOTS = [f"base{i:02X}" for i in range(16)]
OUT = Path(__file__).resolve().parent.parent / ".chezmoidata" / "palettes.yaml"
HEADER = """# GENERATED by tools/fetch-palette. Do not edit.
#
# base16 palettes. Only FZF and lazygit read these -- the terminal takes a theme
# name, because base16 maps ANSI black to base00 with no light/dark branch.
#
#   tools/fetch-palette <name> <url>

palettes:
"""


def fetch(url):
    return subprocess.run(
        ["curl", "-fsSL", url], capture_output=True, text=True, check=True
    ).stdout


def parse(text):
    colors = {}
    for slot in SLOTS:
        m = re.search(rf'^\s*{slot}:\s*["\']?#?([0-9a-fA-F]{{6}})', text, re.M)
        if not m:
            raise SystemExit(f"fetch-palette: {slot} missing from source")
        colors[slot] = "#" + m.group(1).lower()
    return colors


def read_existing():
    if not OUT.exists():
        return {}
    out, cur = {}, None
    for line in OUT.read_text().splitlines():
        block = re.match(r"^  (\S+):$", line)
        if block:
            cur = block.group(1)
            out[cur] = {}
            continue
        kv = re.match(r"^    (\S+):\s*(.*)$", line)
        if kv and cur:
            out[cur][kv.group(1)] = kv.group(2).strip('"')
    return out


def emit(all_palettes):
    parts = [HEADER]
    for name in sorted(all_palettes):
        entry = all_palettes[name]
        parts.append(f"  {name}:\n")
        parts.append(f"    source: {entry['source']}\n")
        for slot in SLOTS:
            parts.append(f'    {slot}: "{entry[slot]}"\n')
    OUT.write_text("".join(parts))


def main():
    if len(sys.argv) != 3:
        raise SystemExit("usage: fetch-palette <name> <url>")
    name, url = sys.argv[1], sys.argv[2]
    entry = parse(fetch(url))
    entry["source"] = url
    all_palettes = read_existing()
    all_palettes[name] = entry
    emit(all_palettes)
    print(f"{name}: 16 slots <- {url}")


main()
