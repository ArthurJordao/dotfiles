{{- $me := index .hosts .hostname -}}
{{- $roles := $me.roles -}}
{{- $quadlets := index $me "quadlets" | default list -}}
{{ if or (has "minecraft" $roles) (has "podman" $roles) (has "sunshine" $roles) (has "emulation" $roles) (has "server" $roles) -}}
#!/bin/bash
set -euo pipefail

systemctl --user daemon-reload
{{ if has "podman" $roles -}}
systemctl --user enable --now podman-auto-update.timer
{{ end -}}
{{ if has "homepage" $quadlets -}}
# homepage reads container state through the docker-compatible API, which only
# exists once this socket is up.
systemctl --user enable --now podman.socket
{{ end -}}
{{ if has "minecraft" $roles -}}
systemctl --user enable --now minecraft-backup.timer
{{ end -}}
{{ if has "sunshine" $roles -}}
# Must be the real unit name: the Alias=sunshine.service symlink is only
# created by enabling, so the short name doesn't resolve until after this runs.
systemctl --user enable --now app-dev.lizardbyte.app.Sunshine.service
{{ end -}}
{{ if has "emulation" $roles -}}
systemctl --user enable --now syncthing.service
{{ end -}}
{{ if has "server" $roles -}}
systemctl --user enable --now olivetin.service
systemctl --user enable --now notes-backup.timer
{{ end -}}
{{ end }}
