{{- $roles := (index .hosts .hostname).roles -}}
{{ if or (has "ddns" $roles) (has "minecraft" $roles) (has "podman" $roles) (has "sunshine" $roles) (has "emulation" $roles) -}}
#!/bin/bash
set -euo pipefail

systemctl --user daemon-reload
{{ if has "ddns" $roles -}}
systemctl --user enable --now cloudflare-ddns.service
systemctl --user enable --now cloudflare-ddns.timer
{{ end -}}
{{ if has "podman" $roles -}}
systemctl --user enable --now podman-auto-update.timer
{{ end -}}
{{ if has "minecraft" $roles -}}
systemctl --user enable --now minecraft-backup.timer
{{ end -}}
{{ if has "sunshine" $roles -}}
# Must be the real unit name: the Alias=sunshine.service symlink is only
# created by enabling, so the short name doesn't resolve until after this runs.
systemctl --user enable --now app-dev.lizardbyte.app.Sunshine.service
{{ end -}}
{{ if has "emulation" $roles -}}
systemctl --user enable --now syncthing.service
{{ end -}}
{{ end }}
