{{- $roles := (index .hosts .hostname).roles -}}
{{- $binaries := includeTemplate "has-binaries" . -}}
{{ if or (has "minecraft" $roles) (has "podman" $roles) (has "sunshine" $roles) (has "emulation" $roles) (has "server" $roles) (has "agent" $roles) $binaries -}}
#!/bin/bash
set -euo pipefail

systemctl --user daemon-reload
{{ if has "podman" $roles -}}
systemctl --user enable --now podman-auto-update.timer
{{ end -}}
{{ if has "minecraft" $roles -}}
systemctl --user enable --now minecraft-backup.timer
{{ end -}}
{{ if has "sunshine" $roles -}}
# Must be the real unit name: the Alias=sunshine.service symlink is only
# created by enabling, so the short name doesn't resolve until after this runs.
systemctl --user enable --now app-dev.lizardbyte.app.Sunshine.service
{{ end -}}
{{ if has "emulation" $roles -}}
systemctl --user enable --now syncthing.service
{{ end -}}
{{ if has "server" $roles -}}
systemctl --user enable --now olivetin.service
systemctl --user enable --now notes-backup.timer
{{ end -}}
{{ if $binaries -}}
systemctl --user enable --now binaries-check.timer
{{ end -}}
{{ if has "agent" $roles -}}
# Needs a `claude` login on this host first; without one it restarts forever.
systemctl --user enable --now claude-remote-control.service
{{ end -}}
{{ end }}
