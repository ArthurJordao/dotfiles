{{ if has "homepage" (index (index .hosts .hostname) "quadlets" | default list) -}}
#!/bin/bash
set -euo pipefail
# settings.yaml: {{ include "dot_config/homepage/settings.yaml.tmpl" | sha256sum }}
# services.yaml: {{ include "dot_config/homepage/services.yaml.tmpl" | sha256sum }}
# widgets.yaml:  {{ include "dot_config/homepage/widgets.yaml.tmpl" | sha256sum }}
#
# Hash the data too: a hosts.yaml, dashboard.yaml or theme.yaml edit changes the
# output while leaving every template byte-identical.
# data:          {{ dict "dashboard" .dashboard "hosts" .hosts "theme" .theme | toJson | sha256sum }}

# Homepage watches its config directory, but chezmoi writes by atomic rename and
# the watcher does not see the replacement through the bind mount.
systemctl --user daemon-reload
if systemctl --user cat homepage.service >/dev/null 2>&1; then
    echo "Restarting homepage (config changed)..."
    systemctl --user restart homepage.service
else
    echo "homepage.service is not generated yet -- start it with:"
    echo "  systemctl --user start homepage.service"
fi
{{ end }}
