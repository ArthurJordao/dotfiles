{{ if has "edge" (index .hosts .hostname).roles -}}
#!/bin/bash
set -euo pipefail

# The configs are inlined below rather than rendered by a nested
# `chezmoi execute-template`: that child run gets no --config and its own op
# session, which breaks simulate-host and any headless apply. Inlining also
# makes this script's own bytes the run_onchange trigger.

echo "Deploying /etc/ configs..."

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

# Stage before installing: `sudo tee` would truncate the live config first.
install_edge() {
    # $1 = destination, $2 = mode
    # -D: a fresh edge host has none of these directories yet.
    sudo install -D -m "$2" -o root -g root "$STAGE/out" "$1"
}

cat > "$STAGE/out" <<'EDGE_EOF'
{{ includeTemplate "etc/caddy/Caddyfile" . | trimSuffix "\n" }}
EDGE_EOF
install_edge /etc/caddy/Caddyfile 644

cat > "$STAGE/out" <<'EDGE_EOF'
{{ includeTemplate "etc/caddy/caddy.env" . | trimSuffix "\n" }}
EDGE_EOF
install_edge /etc/caddy/caddy.env 600

cat > "$STAGE/out" <<'EDGE_EOF'
{{ includeTemplate "etc/coredns/Corefile" . | trimSuffix "\n" }}
EDGE_EOF
install_edge /etc/coredns/Corefile 644

cat > "$STAGE/out" <<'EDGE_EOF'
{{ includeTemplate "etc/cloudflared/config.yml" . | trimSuffix "\n" }}
EDGE_EOF
install_edge /etc/cloudflared/config.yml 644

cat > "$STAGE/out" <<'EDGE_EOF'
{{ includeTemplate "etc/cloudflared/credentials.json" . | trimSuffix "\n" }}
EDGE_EOF
install_edge /etc/cloudflared/{{ .cloudflare.tunnel_id }}.json 600

# The units themselves, so a fresh edge host needs nothing hand-written. The
# caddy account is not packaged either, and caddy.service runs as it.
getent passwd caddy >/dev/null || \
    sudo useradd --system --home-dir /var/lib/caddy --shell /usr/sbin/nologin caddy
sudo install -d -m 755 -o caddy -g caddy /var/lib/caddy

{{ range $unit := list "caddy.service" "coredns.service" "cloudflared.service" "cloudflared-update.service" "cloudflared-update.timer" -}}
cat > "$STAGE/out" <<'EDGE_EOF'
{{ includeTemplate (printf "etc/systemd/%s" $unit) $ | trimSuffix "\n" }}
EDGE_EOF
install_edge /etc/systemd/system/{{ $unit }} 644

{{ end -}}
sudo systemctl daemon-reload

echo "Reloading services..."
sudo systemctl enable --now caddy coredns cloudflared cloudflared-update.timer
sudo systemctl reload caddy || sudo systemctl restart caddy
sudo systemctl restart coredns
sudo systemctl restart cloudflared
{{ end }}
