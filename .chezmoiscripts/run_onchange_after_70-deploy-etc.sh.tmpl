{{- $roles := (index .hosts .hostname).roles -}}
{{- $groups := list -}}
{{- range $name, $g := .etc -}}
{{- if has $name $roles -}}{{ $groups = append $groups $name }}{{ end -}}
{{- end -}}
{{ if $groups -}}
#!/bin/bash
set -euo pipefail

# The bodies are inlined below rather than rendered by a nested
# `chezmoi execute-template`: that child run gets no --config and its own op
# session, which breaks simulate-host and any headless apply. Inlining also
# makes this script's own bytes the run_onchange trigger.
#
# What lands where comes from .chezmoidata/etc.yaml, keyed by role. Setup that
# is not a file stays imperative below.

echo "Deploying /etc/ configs..."

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

# Stage before installing: `sudo tee` would truncate the live config first.
install_etc() {
    # $1 = destination, $2 = mode
    # -D: a fresh host has none of these directories yet.
    sudo install -D -m "$2" -o root -g root "$STAGE/out" "$1"
}

{{ if has "edge" $roles -}}
# --- edge prerequisites: not files, so not in the table ---

# caddy.service runs as this account, and no package creates it.
getent passwd caddy >/dev/null || \
    sudo useradd --system --home-dir /var/lib/caddy --shell /usr/sbin/nologin caddy
# ACME state, and the access logs the Caddyfile writes.
sudo install -d -m 755 -o caddy -g caddy /var/lib/caddy /var/log/caddy

# CoreDNS serves DoT on the `dns` endpoint and refuses to start without a cert.
# Self-signed is the point: the endpoint carries tls_insecure, so nothing
# validates it.
if [ ! -f /etc/coredns/cert.pem ]; then
    sudo install -d -m 755 /etc/coredns
    sudo openssl req -x509 -newkey rsa:4096 -sha256 -days 3650 -nodes \
        -subj "/CN=localhost" \
        -keyout /etc/coredns/key.pem -out /etc/coredns/cert.pem 2>/dev/null
    sudo chmod 644 /etc/coredns/cert.pem
    sudo chmod 600 /etc/coredns/key.pem
fi

# systemd-resolved's stub holds 127.0.0.53:53 and stops CoreDNS binding :53.
# With it off, resolved writes the real upstreams into resolv.conf instead.
# DNS=127.0.0.1 with Domains=~. sends every query to the CoreDNS above rather
# than to whatever DHCP hands out.
sudo install -d -m 755 /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNSStubListener=no\nDNS=127.0.0.1\nDomains=~.\nFallbackDNS=1.1.1.1\n' \
    | sudo tee "$STAGE/resolved" >/dev/null
if ! cmp -s "$STAGE/resolved" /etc/systemd/resolved.conf.d/10-coredns.conf; then
    sudo install -m 644 -o root -g root "$STAGE/resolved" /etc/systemd/resolved.conf.d/10-coredns.conf
    sudo rm -f /etc/systemd/resolved.conf.d/10-no-stub.conf
    sudo systemctl restart systemd-resolved
fi

{{ end -}}
{{ if has "samba" $roles -}}
{{- $op := onepasswordItemFields .secrets.items.samba .secrets.vault -}}
# --- samba prerequisites: passdb is state, not a file ---

# Samba keeps its own password database, so this is NOT the Unix password. Set
# it only when absent: on steady state the secret is never piped anywhere.
[ -d /var/log/samba ] || sudo install -d -m 755 /var/log/samba
if ! sudo pdbedit -L -u {{ (index .hosts .hostname).user }} >/dev/null 2>&1; then
    sudo smbpasswd -s -a {{ (index .hosts .hostname).user }} <<'SMBPW_EOF'
{{ (index $op "SMB_PASSWORD").value }}
{{ (index $op "SMB_PASSWORD").value }}
SMBPW_EOF
fi

{{ end -}}
{{ range $group := $groups -}}
{{- $g := index $.etc $group -}}
{{- $files := index $g "files" | default list -}}
{{- $enable := index $g "enable" | default list -}}
{{- $reload := index $g "reload" | default list -}}
{{- $restart := index $g "restart" | default list -}}
# --- {{ $group }} ---
{{ range $f := $files -}}
cat > "$STAGE/out" <<'ETC_EOF'
{{ includeTemplate (printf "etc/%s" $f.src) $ | trimSuffix "\n" }}
ETC_EOF
install_etc {{ $f.dest | replace "{tunnel_id}" $.cloudflare.tunnel_id }} {{ $f.mode }}

{{ end -}}
{{ if $enable -}}
sudo systemctl daemon-reload
sudo systemctl enable --now {{ join " " $enable }}
{{ end -}}
{{ range $u := $reload -}}
sudo systemctl reload {{ $u }} || sudo systemctl restart {{ $u }}
{{ end -}}
{{ range $u := $restart -}}
sudo systemctl restart {{ $u }}
{{ end }}
{{ end -}}
{{ end }}
