{{ if has "edge" (index .hosts .hostname).roles -}}
#!/bin/bash
set -euo pipefail
# Caddyfile:   {{ include "etc/caddy/Caddyfile.tmpl" | sha256sum }}
# caddy.env:   {{ include "etc/caddy/caddy.env.tmpl" | sha256sum }}
# Corefile:    {{ include "etc/coredns/Corefile.tmpl" | sha256sum }}
# cloudflared: {{ include "etc/cloudflared/config.yml.tmpl" | sha256sum }}
#
# Hash the data too: an edit there changes the output while leaving every
# template byte-identical.
# data:        {{ dict "hosts" .hosts "domain" .domain | toJson | sha256sum }}

SRC="{{ .chezmoi.sourceDir }}"

echo "Deploying /etc/ configs..."

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

# Stage before installing: `sudo tee` would truncate the live config before a
# failing template produced a byte.
render() {
    # $1 = source template, $2 = destination, $3 = mode
    chezmoi execute-template < "$SRC/$1" > "$STAGE/out"
    sudo install -m "$3" -o root -g root "$STAGE/out" "$2"
}

render etc/caddy/Caddyfile.tmpl        /etc/caddy/Caddyfile     644
render etc/caddy/caddy.env.tmpl        /etc/caddy/caddy.env     600
render etc/coredns/Corefile.tmpl       /etc/coredns/Corefile    644
render etc/cloudflared/config.yml.tmpl /etc/cloudflared/config.yml 644

echo "Reloading services..."
sudo systemctl reload caddy || true
sudo systemctl restart coredns || true
sudo systemctl restart cloudflared || true
{{ end }}
