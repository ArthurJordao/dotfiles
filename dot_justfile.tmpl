# Apply dotfiles
apply:
    chezmoi apply

{{ if eq .chezmoi.os "darwin" -}}
# Install declared packages
packages:
    brew bundle --file ~/Brewfile

# Upgrade everything, then prune undeclared
upgrade: packages
    brew upgrade --cask --greedy
    brew bundle cleanup --file ~/Brewfile --force
{{ else -}}
# Install declared packages
packages:
    ~/.local/scripts/install-packages

# Full system upgrade, then install declared
upgrade:
    paru -Syu
    ~/.local/scripts/install-packages
{{ end }}
# Update tmux plugins
tpm-update:
    ~/.tmux/plugins/tpm/bin/update_plugins all

# Full update: apply dotfiles + upgrade packages
update: apply upgrade
