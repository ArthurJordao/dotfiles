# Apply dotfiles
apply:
    #!/usr/bin/env bash
    set -euo pipefail
    op whoami >/dev/null 2>&1 || eval "$(op signin --account my.1password.com)"
    chezmoi apply

# Pull from the remote, then apply
update:
    #!/usr/bin/env bash
    set -euo pipefail
    op whoami >/dev/null 2>&1 || eval "$(op signin --account my.1password.com)"
    chezmoi update

# Run every repo check: templates, schemas, list consistency, shellcheck
check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "$(chezmoi source-path)"
    tools/check

{{ if eq (index .hosts .hostname).os "darwin" -}}
# Install declared packages
packages:
    brew bundle --file ~/Brewfile

# Report installed packages that aren't declared
packages-check:
    brew bundle cleanup --file ~/Brewfile

# Remove installed packages that aren't declared
packages-prune:
    brew bundle cleanup --file ~/Brewfile --force

# Install declared packages, then upgrade everything
upgrade: packages
    brew upgrade --cask --greedy
{{ else -}}
{{- $sysupgrade := "paru -Syu" -}}
{{- if eq (index (index .hosts .hostname) "distro" | default "") "debian" -}}
{{- $sysupgrade = "sudo apt-get update\n    sudo apt-get upgrade -y" -}}
{{- end -}}
# Install declared packages
packages:
    ~/.local/scripts/install-packages

# Full system upgrade, then install declared.
# Arch: -Syu, because `paru -S` against a stale database 404s, and a partial
# upgrade breaks Arch. Debian: upgrade, not full-upgrade, which would remove
# packages to satisfy dependencies.
upgrade:
    {{ $sysupgrade }}
    ~/.local/scripts/install-packages
{{ end }}
{{ if has "emulation" (index .hosts .hostname).roles }}
# Report emulation sync drift: conflicts, versions, stray emulator files
emu-sync-check:
    ~/.local/scripts/emu-sync-check

# Merge ES-DE gamelist sync-conflicts back into the live gamelists
emu-merge-gamelists:
    ~/.local/scripts/emu-merge-gamelists
{{ end }}
{{ if has "podman" (index .hosts .hostname).roles }}
# Report where this host disagrees with what the repo declares
check-live:
    ~/.local/scripts/check-live
{{ end }}
{{ if includeTemplate "has-binaries" . }}
# Report pinned vs installed vs upstream for hand-installed binaries
binaries-check:
    ~/.local/scripts/binaries-check --upstream
{{ end }}
