{{- if has "arkos" (index .hosts .hostname).roles -}}
// Syncthing ignore list for the emu-roms folder, ArkOS hosts.
//
// Double duty: this both limits what the host receives and protects what it
// keeps. An ignored path is not part of the folder, so in a Receive Only
// folder it is neither synced nor flagged as locally changed.
//
// First match wins, so `!` includes come first. A leading `/` anchors to root.

// --- excludes: optical systems this hardware cannot run ---
/psx
/dreamcast
/psp
/ps2
/ss
/wii&ngc

// --- excludes: not part of the shared library ---
/varcade
/anbernic
/tools
/themes

// --- excludes: ArkOS's own files inside the ROM tree ---
gamelist.xml
/.config
(?i)*.sh
(?i)*.exe
(?i)*.dll
*.log
{{ else -}}
// Syncthing ignore list for the emu-roms folder.
// Deployed by chezmoi, gated on the `emulation` role.
//
// ~/Emulation/roms is not pure content — EmuDeck installs emulators and
// per-host launchers inside the ROM tree, and none of it should cross hosts.
//
// First match wins, so the `!` includes come first. A leading `/` anchors to
// the folder root; without one a pattern matches at any depth.
//
// Prefer structural rules to listing files. `just emu-sync-check` reports
// what is not covered here.

// --- includes, first ---
// Only this subdirectory of model2 holds games.
!/model2/roms
!/model2/roms/**

// --- excludes ---

// EmuDeck's generated per-host launcher scripts.
/emulators

// The Sega Model 2 emulator install — everything but the roms/ admitted above.
/model2/*

// Cemu installed into the Wii U ROM directory.
/wiiu/gameProfiles
/wiiu/resources

// Xenia's own files living in the Xbox 360 ROM directory.
/xbox360/xenia.sh
/xbox360/xenia-canary.config.toml
/xbox360/portable.txt
/xbox360/LICENSE.TXT

// Windows binaries are never console ROMs, at any depth.
(?i)*.exe
(?i)*.dll

// Per-host noise.
*.log
{{ end -}}
