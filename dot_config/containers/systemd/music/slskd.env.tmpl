# Soulseek (rede)
# NOTE: values are intentionally unquoted. Podman's --env-file (used by quadlets)
# does NOT strip surrounding quotes, so `| quote` would embed literal quotes in
# the value. Passwords must not contain a literal `#` or leading/trailing spaces.
SLSKD_SLSK_USERNAME={{ onepasswordRead "op://dotfiles/mars-secrets/SLSKD_SLSK_USERNAME" }}
SLSKD_SLSK_PASSWORD={{ onepasswordRead "op://dotfiles/mars-secrets/SLSKD_SLSK_PASSWORD" }}

# slskd web UI
SLSKD_USERNAME={{ onepasswordRead "op://dotfiles/mars-secrets/SLSKD_WEB_USERNAME" }}
SLSKD_PASSWORD={{ onepasswordRead "op://dotfiles/mars-secrets/SLSKD_WEB_PASSWORD" }}

# API key for SoulSync (must be >= 16 chars)
SLSKD_API_KEY={{ onepasswordRead "op://dotfiles/mars-secrets/SLSKD_API_KEY" }}
