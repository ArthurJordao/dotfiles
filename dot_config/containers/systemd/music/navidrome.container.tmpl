{{- $external := includeTemplate "storage-path" (dict "hosts" .hosts "name" "external") -}}
[Unit]
Description=Navidrome Music Server
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/deluan/navidrome:latest
ContainerName=navidrome
AutoUpdate=registry
Network=music.network
# Navidrome is served as `music`, not under its own name.
PublishPort={{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "music") }}:4533

Environment=ND_MUSICFOLDER=/music
Environment=ND_DATAFOLDER=/data
Environment=ND_PORT=4533
Environment=ND_SCANNER_PURGEMISSING=always
Environment=TZ={{ .timezone }}

Volume={{ $external }}/music:/music:ro
Volume=navidrome-data:/data

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
