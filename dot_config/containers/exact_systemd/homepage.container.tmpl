[Unit]
Description=Homepage — service overview
Wants=network-online.target
After=network-online.target
# Per-tile container state and CPU/memory come from the podman socket.
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/gethomepage/homepage:latest
AutoUpdate=registry
# Loopback only: homepage has no authentication of its own, so Caddy is the
# only way in.
PublishPort=127.0.0.1:{{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "home") }}:3000

Environment=TZ={{ .timezone }}
# Required since v1.0 -- any other Host header gets a 400, including a direct
# hit on the port. Comma-separated, no spaces.
Environment=HOMEPAGE_ALLOWED_HOSTS=home.{{ .domain }}

EnvironmentFile=%h/.config/containers/systemd/homepage.env

Volume=%h/.config/homepage:/app/config
# The rootless socket speaks the docker API. uid 0 so container-root maps to
# the host user that owns it.
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
User=0

[Service]
Restart=always

[Install]
WantedBy=default.target
