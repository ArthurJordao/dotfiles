[Unit]
Description=Glance — service dashboard
Wants=network-online.target
After=network-online.target
# The docker-containers widget reads container state through this socket.
Requires=podman.socket
After=podman.socket
StartLimitIntervalSec=0

[Container]
Image=docker.io/glanceapp/glance:latest
AutoUpdate=registry
# Host networking, not PublishPort: the monitor widget checks every other
# service's own loopback-bound port, and a rootless container's 127.0.0.1 is
# its own network namespace, never the host's -- pasta can't hairpin a
# connection back to the host's own address either, confirmed on pluto (curl
# from the host works, the same request from inside a bridged container was
# refused). glance.yml binds its own listener to 127.0.0.1 to keep the
# "Caddy is the way in" rule intact despite sharing the host's network.
Network=host

Environment=TZ={{ .timezone }}
EnvironmentFile=%h/.config/containers/systemd/glance.env

Volume=%h/.config/glance:/app/config
# The rootless socket speaks the docker API; uid 0 so container-root maps to
# the host user that owns it (same trick as the music stack).
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro
User=0

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
