{{- $s := index .secrets.items "wallabag" -}}
{{- $op := onepasswordItemFields $s.item_name $s.vault -}}
# Token signing. The image's built-in default is a published constant.
# Unquoted: podman's --env-file does not strip surrounding quotes.
SYMFONY__ENV__SECRET={{ (index $op "WALLABAG_SECRET").value }}
