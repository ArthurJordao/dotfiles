{{- $tiles := includeTemplate "dashboard-tiles" (dict "hosts" .hosts "hostname" .hostname "tiles" .dashboard.tiles) | fromJson -}}
# GENERATED — widget credentials, named for what services.yaml references as
# {{ "{{HOMEPAGE_VAR_<TILE>_<FIELD>}}" }}. Unquoted: podman's --env-file keeps
# quotes literally.
{{- range $g := $tiles.groups }}
{{- range $t := $g.tiles }}
{{- $w := $t.widget }}
{{- if and $w (index $w "item") }}
{{- $op := onepasswordItemFields (index $.secrets.items (index $w "item")) $.secrets.vault }}
{{- range $field, $opfield := (index $w "fields" | default dict) }}
HOMEPAGE_VAR_{{ upper (replace "-" "_" $t.name) }}_{{ upper $field }}={{ (index $op $opfield).value }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
