{{- $media := includeTemplate "storage-path" (dict "hosts" .hosts "name" "media") -}}
[Unit]
Description=Calibre-Web-Automated ebook library
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/crocodilestick/calibre-web-automated:latest
AutoUpdate=registry
# CWA is served as `books`, not under its own name.
PublishPort=127.0.0.1:{{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "books") }}:8083

# Run as uid/gid 0, which maps to the host user (turisa) under rootless podman,
# so CWA can write the Calibre library and ingest dirs.
Environment=PUID=0
Environment=PGID=0
Environment=UMASK=022
Environment=TZ={{ .timezone }}
# The inotify watcher misses files written while it restarts and never rescans,
# stranding them forever. The polling watcher CWA ships has no missed-event mode.
Environment=CWA_WATCH_MODE=poll
# Stops cwa-init chowning the ingest dir to abc:abc on every start, which it
# does regardless of PUID -- leaving a directory the host user cannot delete
# from, so pdf2epub could not move a PDF out of it. Also forces the polling
# watcher, which is why CWA_WATCH_MODE above is belt and braces.
Environment=NETWORK_SHARE_MODE=true

Volume=cwa-config:/config
Volume={{ $media }}/books:/calibre-library
Volume={{ $media }}/book-ingest:/cwa-book-ingest

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
