{{- $external := includeTemplate "storage-path" (dict "hosts" .hosts "name" "external") -}}
[Unit]
Description=Calibre-Web-Automated ebook library
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/crocodilestick/calibre-web-automated:latest
AutoUpdate=registry
# CWA is served as `books`, not under its own name.
PublishPort={{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "books") }}:8083

# Run as uid/gid 0, which maps to the host user (turisa) under rootless podman,
# so CWA can write the Calibre library and ingest dirs on the external SSD.
Environment=PUID=0
Environment=PGID=0
Environment=UMASK=022
Environment=TZ={{ .timezone }}

Volume=cwa-config:/config
Volume={{ $external }}/books:/calibre-library
Volume={{ $external }}/book-ingest:/cwa-book-ingest

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
