{{- $media := includeTemplate "storage-path" (dict "hosts" .hosts "name" "media") -}}
[Unit]
Description=slskd (Soulseek daemon)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Container]
Image=docker.io/slskd/slskd:latest
ContainerName=slskd
AutoUpdate=registry
Network=music.network
PublishPort={{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "slskd") }}:5030
# Soulseek peer traffic, not proxied — no endpoint to read it from.
PublishPort=50300:50300

Environment=SLSKD_DOWNLOADS_DIR=/downloads
Environment=SLSKD_SHARED_DIR=/music
Environment=SLSKD_REMOTE_CONFIGURATION=true
Environment=TZ={{ .timezone }}
EnvironmentFile=%h/.config/containers/systemd/music/slskd.env

Volume={{ $media }}/downloads:/downloads
Volume={{ $media }}/music:/music:ro
Volume=slskd-config:/app

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
