{{- $s := index .secrets.items "glance" -}}
{{- $op := onepasswordItemFields $s.item_name $s.vault -}}
# Read by glance.yml's ${VAR} substitution for the GitHub PR widgets.
# Unquoted: podman's --env-file does not strip surrounding quotes.
GLANCE_GITHUB_USERNAME={{ (index $op "GITHUB_USERNAME").value }}
GLANCE_GITHUB_TOKEN={{ (index $op "GITHUB_TOKEN").value }}
