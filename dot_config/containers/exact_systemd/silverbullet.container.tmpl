{{- $external := includeTemplate "storage-path" (dict "hosts" .hosts "name" "external") -}}
[Unit]
Description=SilverBullet notes
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/silverbulletmd/silverbullet:latest
AutoUpdate=registry
PublishPort={{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "notes") }}:3000

Environment=TZ={{ .timezone }}
EnvironmentFile=%h/.config/containers/systemd/silverbullet.env

# uid 0 so the files it writes belong to the host user and basic-memory can
# index them.
User=0
# The space IS the basic-memory project, so everything SilverBullet creates on
# its own — Journal, Inbox, tasks — is indexed rather than sitting beside it.
Volume={{ $external }}/memory/personal:/space

[Service]
Restart=always

[Install]
WantedBy=default.target
