{{- $op := onepasswordItemFields .secrets.items.immich .secrets.vault -}}
# Banco de dados
DB_HOSTNAME=localhost
DB_PORT=5432
DB_USERNAME=immich
DB_PASSWORD={{ (index $op "IMMICH_DB_PASSWORD").value }}
DB_DATABASE_NAME=immich

# Redis
REDIS_HOSTNAME=localhost
REDIS_PORT=6379

# Imagens
IMMICH_VERSION=release

# Timezone
TZ={{ .timezone }}

POSTGRES_USER=immich
POSTGRES_PASSWORD={{ (index $op "IMMICH_DB_PASSWORD").value }}
POSTGRES_DB=immich
POSTGRES_INITDB_ARGS=--data-checksums
IMMICH_MACHINE_LEARNING_URL=http://localhost:3003
