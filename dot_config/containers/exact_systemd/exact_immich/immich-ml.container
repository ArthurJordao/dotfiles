[Unit]
Description=Immich Machine Learning
Requires=immich-pod.service
After=immich-pod.service

[Container]
Image=ghcr.io/immich-app/immich-machine-learning:release-cuda
Pod=immich.pod
AutoUpdate=registry
Environment=MACHINE_LEARNING_DEVICE_IDS=0
AddDevice=nvidia.com/gpu=all

Volume=immich-ml-cache:/cache

[Service]
# This image does not trap SIGTERM, so its PID 1 dies from the signal and
# podman reports 143 -- a clean stop that systemd would otherwise call a
# failure, leaving the unit failed every time gaming mode stops it.
SuccessExitStatus=143
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
