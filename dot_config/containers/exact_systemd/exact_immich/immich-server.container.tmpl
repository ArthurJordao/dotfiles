{{- $external := includeTemplate "storage-path" (dict "hosts" .hosts "name" "external") -}}
[Unit]
Description=Immich Server
Requires=immich-pod.service immich-db.service immich-valkey.service
After=immich-pod.service immich-db.service immich-valkey.service

[Container]
Image=ghcr.io/immich-app/immich-server:release
Pod=immich.pod
AutoUpdate=registry
AddDevice=nvidia.com/gpu=all
Environment=NVIDIA_VISIBLE_DEVICES=all
Environment=NVIDIA_DRIVER_CAPABILITIES=video,compute,utility

EnvironmentFile=%h/.config/containers/systemd/immich/immich.env
Volume=%h/immich/library:/usr/src/app/upload
Volume=/etc/localtime:/etc/localtime:ro
Volume={{ $external }}:/mnt/ssd:ro

[Service]
# This image does not trap SIGTERM, so its PID 1 dies from the signal and
# podman reports 143 -- a clean stop that systemd would otherwise call a
# failure, leaving the unit failed every time gaming mode stops it.
SuccessExitStatus=143
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
