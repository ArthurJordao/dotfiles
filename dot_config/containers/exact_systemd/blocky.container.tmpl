[Unit]
Description=blocky DNS filter (CoreDNS forwards here; Cloudflare is the fallback)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/0xerr0r/blocky:latest
AutoUpdate=registry

# Loopback only: the API is unauthenticated and can switch blocking off.
PublishPort=127.0.0.1:{{ .dns.filter.port }}:53/udp
PublishPort=127.0.0.1:{{ .dns.filter.port }}:53/tcp
PublishPort=127.0.0.1:{{ .dns.filter.api_port }}:4000

Environment=TZ={{ .timezone }}

Volume=%h/.config/blocky/config.yml:/app/config.yml:ro
# The query log. A named volume, not a host path: the image runs as uid 100, so
# podman has to own the directory to chown it for that user.
Volume=blocky-data:/app/data

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
