{{- $s := includeTemplate "secret-coords" (dict "secrets" .secrets "key" "cloudflare-ddns") | fromJson -}}
{{- $op := onepasswordItemFields $s.item $s.vault -}}
# Unquoted on purpose: podman's --env-file keeps literal quotes.
# Needs Cloudflare's "Edit DNS" capability on the zone.
CLOUDFLARE_API_TOKEN={{ (index $op "CLOUDFLARE_API_TOKEN").value }}
