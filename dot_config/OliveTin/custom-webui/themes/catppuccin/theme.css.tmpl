{{- $p := index .palettes (.dashboard.palette) -}}
/* GENERATED from .chezmoidata/palettes.yaml — {{ .dashboard.palette }}.
   Edit `dashboard.palette`, not this file. */
:root {
  --text-color: {{ $p.base05 }};
  --border-color: {{ $p.base02 }};
  --standout-bg-color: {{ $p.base01 }};

  --hover-background-color: {{ $p.base02 }};
  --hover-text-color: {{ $p.base06 }};
  --header-hover-background-color: {{ $p.base02 }};
  --header-hover-text-color: {{ $p.base06 }};

  --disabled-background-color: {{ $p.base01 }};
  --disabled-text-color: {{ $p.base03 }};

  --karma-good: {{ $p.base0B }};      --karma-good-fg: {{ $p.base00 }};
  --karma-bad: {{ $p.base08 }};       --karma-bad-fg: {{ $p.base00 }};
  --karma-bad-border: {{ $p.base08 }};
  --karma-warning: {{ $p.base0A }};   --karma-warning-fg: {{ $p.base00 }};
  --karma-severe: {{ $p.base09 }};    --karma-severe-fg: {{ $p.base00 }};
  --karma-important: {{ $p.base0A }}; --karma-important-fg: {{ $p.base00 }};
  --karma-note: {{ $p.base0D }};      --karma-note-fg: {{ $p.base00 }};
  --karma-info: {{ $p.base02 }};      --karma-info-fg: {{ $p.base05 }};
  --karma-old: {{ $p.base03 }};       --karma-old-fg: {{ $p.base05 }};
}

/* The page background is not a variable upstream, so it is set directly. */
body {
  background: {{ $p.base00 }};
  color: {{ $p.base05 }};
}

/* Cards: actions, displays and fieldsets. */
.action-button, .display, fieldset, .section {
  background: {{ $p.base01 }};
  border-color: {{ $p.base02 }};
  color: {{ $p.base05 }};
}

a { color: {{ $p.base0D }}; }
a:hover { color: {{ $p.base0C }}; }

/* Container state, coloured by the cssClass the entity sets. */
.display.running { color: {{ $p.base0B }}; }
.display.exited, .display.stopped { color: {{ $p.base08 }}; }
