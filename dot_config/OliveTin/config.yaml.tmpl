{{- $me := index .hosts .hostname -}}
{{- $user := index $me "user" | default "" -}}
{{- $roles := index $me "roles" | default list -}}
{{- $pal := index .palettes .theme.active -}}
{{- $tiles := includeTemplate "dashboard-tiles" (dict "hosts" .hosts "hostname" .hostname "tiles" .dashboard.tiles) | fromJson -}}
{{- $specs := "" -}}
{{- /* Skipping `web: false`: dashboard-status probes over HTTP, and the
       only consumer of a status field is a tile that endpoint no longer has. */ -}}
{{- range (index $me "endpoints" | default list) -}}
{{- $web := true -}}
{{- if hasKey . "web" }}{{ $web = .web }}{{ end -}}
{{- if and (hasKey . "port") $web }}{{ $specs = printf "%s %s:%v" $specs .name .port }}{{ end -}}
{{- end -}}
{{- $statusRefresh := printf "mkdir -p /home/%s/.local/state/olivetin && GOOD='%s' BAD='%s' WARN='%s' dashboard-status%s > /home/%s/.local/state/olivetin/status.json" $user $pal.base0B $pal.base08 $pal.base0A $specs $user -}}
{{- $op := onepasswordItemFields .secrets.items.olivetin .secrets.vault -}}
# GENERATED from .chezmoidata/ — edit hosts.yaml and dashboard.yaml, not this.
#
# OliveTin's own {{ "{{ }}" }} placeholders must be emitted as literals here:
# chezmoi would otherwise evaluate them and fail the render.
logLevel: INFO
pageTitle: {{ .hostname }}

# Loopback only — Caddy is the way in.
listenAddressSingleHTTPFrontend: 127.0.0.1:{{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "dash") }}

authRequireGuestsToLogin: true

authLocalUsers:
  enabled: true
  users:
{{- range $username, $user := .dashboard.users }}
    - username: {{ $username }}
      usergroup: {{ $user.group }}
      password: '{{ (index $op $user.secret).value }}'
{{- end }}

# Deny by default; an ACL grants.
defaultPermissions:
  view: false
  exec: false
  logs: false

accessControlLists:
  # addToEveryAction means a newly added button is never accidentally hidden
  # from admins, nor accidentally exposed to anyone else.
  - name: admins
    matchUsergroups: [admins]
    permissions: {view: true, exec: true, logs: true}
    addToEveryAction: true
  - name: family
    matchUsergroups: [family]
    permissions: {view: true, exec: true, logs: true}
  # Cron and startup actions run as the user "cron" and match no other ACL.
  - name: cron
    matchUsernames: [cron]
    permissions: {exec: true}

actions:
{{- range $group, $items := .dashboard.actions }}
{{- range $items }}
{{- $role := index . "role" | default "" }}
{{- if or (eq $role "") (has $role $roles) }}
{{- $on := index . "on" | default "" }}
  - title: {{ .title }}
    shell: '{{ if $on }}ssh -o BatchMode=yes -o ConnectTimeout=5 {{ $on }}.{{ $.domain }} "{{ .shell }}"{{ else }}{{ .shell }}{{ end }}'
{{- with index . "icon" }}
    icon: '<iconify-icon icon="{{ . }}"></iconify-icon>'
{{- end }}
{{- with index . "timeout" }}
    timeout: {{ . }}
{{- end }}
{{- if index . "family" }}
    acls: [family]
{{- end }}
{{- if index . "popup" }}
    popupOnStart: execution-dialog-stdout-only
{{- end }}
    shellAfterCompleted: "{{ $statusRefresh }}"
{{- $arg := index . "argument" }}
{{- if or $arg (index . "confirm") }}
    arguments:
{{- with $arg }}
      # Either a fixed choice list or a shell-safe `type`. OliveTin interpolates
      # the value into the command without escaping, but refuses to run when it
      # fails the type's pattern, so nothing arbitrary reaches sh either way.
      # `index`, not a bare lookup: only one of the two keys is ever present.
      - name: {{ .name }}
        title: {{ .title }}
{{- if index . "type" }}
        type: {{ .type }}
{{- end }}
{{- if eq (index . "choices_from" | default "") "minecraft-instances" }}
        choices:
{{- range $.minecraft.instances }}
          - value: {{ .name }}
{{- end }}
{{- end }}
{{- end }}
{{- if index . "confirm" }}
      - name: confirm
        type: confirmation
        title: 'Really run: {{ .title }}?'
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
  # Feeds the status entity. Colours are passed in so the palette stays in
  # chezmoi data rather than in the script.
  - title: Refresh status
    shell: "{{ $statusRefresh }}"
    timeout: 30
    execOnStartup: true
    execOnCron: '* * * * *'
    acls: [cron]
    hidden: true
  # Feeds the container entity. Runs as turisa, so podman needs no socket.
  - title: Refresh containers
    shell: >-
      mkdir -p /home/{{ $user }}/.local/state/olivetin &&
      podman ps -a --format json |
      python3 -c 'import json,sys; sys.stdout.writelines(json.dumps({"name": c["Names"][0], "state": c["State"], "image": c["Image"]}) + "\n" for c in json.load(sys.stdin))'
      > /home/{{ $user }}/.local/state/olivetin/containers.json
    timeout: 30
    execOnStartup: true
    execOnCron: '* * * * *'
    acls: [cron]
    hidden: true
  - title: 'Start {{ "{{ container.name }}" }}'
    icon: '<iconify-icon icon="mdi:play"></iconify-icon>'
    shell: 'podman start {{ "{{ container.name }}" }}'
    entity: container
    timeout: 60
  - title: 'Stop {{ "{{ container.name }}" }}'
    icon: '<iconify-icon icon="mdi:stop"></iconify-icon>'
    shell: 'podman stop {{ "{{ container.name }}" }}'
    entity: container
    timeout: 60
  - title: 'Logs {{ "{{ container.name }}" }}'
    icon: '<iconify-icon icon="mdi:text-box-outline"></iconify-icon>'
    shell: 'podman logs --tail 200 {{ "{{ container.name }}" }}'
    entity: container
    timeout: 30
    popupOnStart: execution-dialog-stdout-only


entities:
  # Written by the Refresh containers action. NDJSON, one object per line --
  # OliveTin parses entity files line by line, and podman's `--format json`
  # emits an array where docker's emits NDJSON. Deliberately outside the config
  # dir: chezmoi manages that, and would fight OliveTin over a file it rewrites
  # every minute.
  - file: /home/{{ $user }}/.local/state/olivetin/status.json
    name: status
  - file: /home/{{ $user }}/.local/state/olivetin/containers.json
    name: container

dashboards:
  - title: Services
    contents:
{{- range $g := $tiles.groups }}
      - type: fieldset
{{- /* "Other" is not entity-bound: it collects endpoints with no tile, which
       have no status field to show. */ -}}
{{- if not $g.other }}
        entity: status
{{- end }}
        title: {{ $g.name }}
        contents:
{{- range $t := $g.tiles }}
          - type: display
            title: |
              <a href="https://{{ $t.name }}.{{ $.domain }}" style="text-decoration:none;display:block">
              <iconify-icon icon="{{ $t.icon | default "mdi:link-variant" }}" style="font-size:2.6em"></iconify-icon>
              <div style="font-weight:600">{{ $t.label }}</div>
              {{- with $t.description }}
              <div style="opacity:.7;font-size:.85em">{{ . }}</div>
              {{- end }}
              {{- if and $t.local (not $g.other) }}
              {{- $key := replace "-" "_" $t.name }}
              <div style="font-size:.8em;font-weight:600;color:{{ printf "{{ status.svc_%s_color }}" $key }}">{{ printf "{{ status.svc_%s }}" $key }}</div>
              {{- end }}
              </a>
{{- end }}
{{- end }}
  - title: Controls
    contents:
{{- /* Each group gets a status fieldset (entity-bound) directly above a plain
       fieldset of buttons. They must not share one: a linked action inside an
       entity-bound fieldset only counts as placed when the action carries the
       same entity, and plain buttons in there make OliveTin keep its built-in
       Actions view. The button fieldset is left untitled so the pair reads as
       one section. */}}
{{- range $group, $items := .dashboard.actions }}
{{- $members := list }}
{{- range $items }}
{{- $role := index . "role" | default "" }}
{{- if or (eq $role "") (has $role $roles) }}
{{- $members = append $members . }}
{{- end }}
{{- end }}
{{- if $members }}
{{- $st := index $.dashboard.status $group }}
{{- if $st }}
      - type: fieldset
        entity: status
        title: {{ $group }}
        contents:
          - type: display
            title: |
              <div style="display:flex;gap:1.6em;flex-wrap:wrap;align-items:center;justify-content:center;font-size:.95em">
{{- range $st }}
              <span><iconify-icon icon="{{ .icon }}" style="color:{{ printf "{{ status.%s_color }}" .field }};vertical-align:-.15em"></iconify-icon>
              {{ .label }} <b style="color:{{ printf "{{ status.%s_color }}" .field }}">{{ printf "{{ status.%s }}" .field }}</b></span>
{{- end }}
              </div>
{{- end }}
      - type: fieldset
{{- if not $st }}
        title: {{ $group }}
{{- end }}
        contents:
{{- range $members }}
          - title: {{ .title }}
{{- end }}
{{- end }}
{{- end }}
  - title: Containers
    contents:
      - type: fieldset
        entity: container
        title: '{{ "{{ container.name }}" }}'
        contents:
          - type: display
            title: |
              <iconify-icon icon="mdi:docker" style="font-size:1.8em"></iconify-icon>
              <div style="font-weight:600">{{ "{{ container.state }}" }}</div>
              <div style="opacity:.7;font-size:.8em;word-break:break-all">{{ "{{ container.image }}" }}</div>
            cssClass: '{{ "{{ container.state }}" }}'
          - title: 'Start {{ "{{ container.name }}" }}'
          - title: 'Stop {{ "{{ container.name }}" }}'
          - title: 'Logs {{ "{{ container.name }}" }}'
