{{- /* Same tile model OliveTin's dashboard reads -- a service is never
       declared twice, just rendered twice. Only endpoints with a port and not
       `web: false` have a page to link to. */ -}}
{{- $ported := dict -}}
{{- range $hostname, $host := .hosts -}}
{{- range (index $host "endpoints" | default list) -}}
{{- $web := true -}}
{{- if hasKey . "web" }}{{ $web = .web }}{{ end -}}
{{- if and (hasKey . "port") $web }}{{ $_ := set $ported .name true }}{{ end -}}
{{- end -}}
{{- end -}}
{{- $tiled := dict -}}
{{- $groups := list -}}
{{- range $group, $members := .dashboard.tiles -}}
{{- $shown := list -}}
{{- range $name, $tile := $members -}}
{{- $_ := set $tiled $name true -}}
{{- if hasKey $ported $name -}}
{{- $shown = append $shown (dict
      "name" $name
      "label" (index $tile "label" | default $name)
      "icon" (index $tile "icon" | default "")
      "alt_status" (index $tile "alt_status" | default list)) -}}
{{- end -}}
{{- end -}}
{{- if $shown }}{{ $groups = append $groups (dict "name" $group "tiles" $shown) }}{{ end -}}
{{- end -}}
{{- /* An endpoint in no group still gets a tile, so a new service is never
       silently missing here while showing up on OliveTin. */ -}}
{{- $other := list -}}
{{- range $name := (keys $ported | sortAlpha) -}}
{{- if not (hasKey $tiled $name) }}{{ $other = append $other (dict "name" $name "label" $name "icon" "" "alt_status" list) }}{{ end -}}
{{- end -}}
{{- if $other }}{{ $groups = append $groups (dict "name" "Other" "tiles" $other) }}{{ end -}}
# GENERATED from .chezmoidata/ — edit hosts.yaml and dashboard.yaml, not this.
#
# glance's own {{ "{{ }}" }} template placeholders (inside `template:` blocks
# below) must be emitted as literals: chezmoi would otherwise evaluate them.

server:
  # Loopback only — Caddy is the way in, same as every other service, even
  # though Network=host means this binds pluto's own port directly.
  host: 127.0.0.1
  port: {{ template "endpoint-port" (dict "hosts" .hosts "endpoint" "home") }}

theme:
  # catppuccin-latte is the only light variant in theme.yaml; anything else is dark.
  light: {{ eq .theme.active "catppuccin-latte" }}

pages:
  - name: {{ .hostname }}
    columns:
      - size: small
        widgets:
          - type: clock
            hour-format: 24h
            timezone: {{ .timezone }}

          - type: search
            search-engine: duckduckgo

          - type: hacker-news
            limit: 15
            collapse-after: 5
            sparkline: false

          - type: custom-api
            title: My Open PRs
            cache: 15m
            url: https://api.github.com/search/issues
            parameters:
              q: "is:open is:pr author:${GLANCE_GITHUB_USERNAME}"
              sort: updated
              per_page: "10"
            headers:
              Authorization: "Bearer ${GLANCE_GITHUB_TOKEN}"
              Accept: application/vnd.github+json
            template: |
              <ul class="list list-gap-10">
              {{ "{{" }} range .JSON.Array "items" {{ "}}" }}
                <li>
                  <a href="{{ "{{" }} .String "html_url" {{ "}}" }}" target="_blank">{{ "{{" }} .String "title" {{ "}}" }}</a>
                </li>
              {{ "{{" }} end {{ "}}" }}
              </ul>

          - type: custom-api
            title: Review Requested
            cache: 15m
            url: https://api.github.com/search/issues
            parameters:
              q: "is:open is:pr review-requested:${GLANCE_GITHUB_USERNAME}"
              sort: updated
              per_page: "10"
            headers:
              Authorization: "Bearer ${GLANCE_GITHUB_TOKEN}"
              Accept: application/vnd.github+json
            template: |
              <ul class="list list-gap-10">
              {{ "{{" }} range .JSON.Array "items" {{ "}}" }}
                <li>
                  <a href="{{ "{{" }} .String "html_url" {{ "}}" }}" target="_blank">{{ "{{" }} .String "title" {{ "}}" }}</a>
                </li>
              {{ "{{" }} end {{ "}}" }}
              </ul>

      - size: full
        widgets:
{{- range $g := $groups }}
          - type: monitor
            title: {{ $g.name }}
            cache: 2m
            sites:
{{- range $t := $g.tiles }}
              - title: {{ $t.label | quote }}
                url: https://{{ $t.name }}.{{ $.domain }}
{{- with $t.icon }}
                icon: {{ . | replace "selfhst:" "sh:" }}
{{- end }}
{{- if $t.alt_status }}
                alt-status-codes: [{{ range $i, $c := $t.alt_status }}{{ if $i }}, {{ end }}{{ $c }}{{ end }}]
{{- end }}
{{- end }}
{{- end }}

      - size: small
        widgets:
          - type: docker-containers
            sock-path: /var/run/docker.sock
            hide-by-default: false

          - type: server-stats
            servers:
              - type: local
                name: {{ .hostname }}
