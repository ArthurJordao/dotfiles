{{- $tiles := includeTemplate "dashboard-tiles" (dict "hosts" .hosts "hostname" .hostname "tiles" .dashboard.tiles) | fromJson -}}
# GENERATED from .chezmoidata/ — edit hosts.yaml and dashboard.yaml, not this.
{{ range $g := $tiles.groups }}
- {{ $g.name | quote }}:
{{- range $t := $g.tiles }}
{{- /* Our icons are Iconify `prefix:name`; homepage wants `prefix-name`, and
       calls the selfh.st set `sh`. An unmapped prefix renders blank. */}}
    - {{ $t.label | quote }}:
{{- if $t.link }}
        href: https://{{ $t.name }}.{{ $.domain }}
{{- end }}
{{- with $t.description }}
        description: {{ . | quote }}
{{- end }}
{{- with $t.icon }}
        icon: {{ . | replace "selfhst:" "sh:" | replace ":" "-" }}
{{- end }}
{{- if and $t.local $t.container }}
        server: podman
        container: {{ $t.container }}
{{- end }}
{{- if $t.widget }}
{{- $w := $t.widget }}
{{- $port := index $w "port" | default "" }}
{{- $var := upper (replace "-" "_" $t.name) }}
        widget:
          type: {{ index $w "type" }}
          url: {{ index $w "scheme" | default "https" }}://{{ $t.name }}.{{ $.domain }}{{ with $port }}:{{ . }}{{ end }}
{{- /* Credentials arrive as env vars from homepage.env, so no secret is ever
       written into a config file. Homepage substitutes these itself. */}}
{{- range $field, $opfield := (index $w "fields" | default dict) }}
          {{ $field }}: {{ printf "{{HOMEPAGE_VAR_%s_%s}}" $var (upper $field) }}
{{- end }}
{{- end }}
{{- end }}
{{ end }}
