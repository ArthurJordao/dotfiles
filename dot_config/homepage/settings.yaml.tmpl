{{- $tiles := includeTemplate "dashboard-tiles" (dict "hosts" .hosts "hostname" .hostname "tiles" .dashboard.tiles) | fromJson -}}
{{- $hp := .theme.homepage -}}
# GENERATED from .chezmoidata/ — edit theme.yaml, hosts.yaml and dashboard.yaml,
# not this.
title: {{ .hostname }}
theme: {{ $hp.theme }}
color: {{ $hp.color }}
headerStyle: boxedWidgets
statusStyle: dot
hideVersion: true

# Same groups, same order as the OliveTin dashboard: both read
# .chezmoitemplates/dashboard-tiles. 3 columns, not 4, is what the groups
# actually hold, so a row fills instead of leaving a gap on the right.
layout:
{{- range $g := $tiles.groups }}
  {{ $g.name }}:
    style: row
    columns: 3
{{- end }}
