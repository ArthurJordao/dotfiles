{{- $s := index .secrets.items "telegram" -}}
{{- $op := onepasswordItemFields $s.item_name $s.vault -}}
# The bot behind `--channels plugin:telegram@claude-plugins-official`. One token has
# exactly one update consumer, so no other host may poll this bot.
# Unquoted: systemd's EnvironmentFile keeps surrounding quotes literally.
TELEGRAM_BOT_TOKEN={{ (index $op "TELEGRAM_BOT_TOKEN").value }}
