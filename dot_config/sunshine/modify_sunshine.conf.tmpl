#!/bin/bash
# Sunshine's web UI rewrites sunshine.conf whole on every Save, so this is a
# modify_ script owning exactly one line. A managed file would revert the UI.
#
# csrf_allowed_origins: Sunshine's defaults only cover localhost/127.0.0.1/[::1],
# so requests through Caddy are rejected as cross-origin. Comma-separated, not
# a JSON array. Read only at startup — after a rewrite, run
#   systemctl --user restart app-dev.lizardbyte.app.Sunshine.service
set -euo pipefail

# Current contents arrive on stdin. Drop any existing copy of our line so this
# is idempotent; grep exits 1 when it selects nothing, hence the `|| true`.
grep -v '^[[:space:]]*csrf_allowed_origins[[:space:]]*=' || true

echo 'csrf_allowed_origins = https://sunshine.{{ .domain }}'
