[Unit]
Description=Claude Code remote-control server for the dotfiles checkout
Wants=network-online.target
After=network-online.target

[Service]
# Server mode: it waits for the phone or claude.ai to open a session against
# this checkout. Nothing listens locally -- the process dials out.
Type=forking
WorkingDirectory=%h/dev/personal/dotfiles
# Runs inside tmux so it can be attached to answer permission prompts:
#   tmux -L claude attach -t claude
# Its own socket, not the default one minecraft uses: on a shared socket the
# session lands in a tmux server outside this unit's cgroup, so systemd loses
# the main PID and Restart= never fires.
# A pane inherits the tmux server's environment, not the unit's, so PATH goes
# through -e. Tools run through a non-login shell.
ExecStart=/usr/bin/tmux -L claude new-session -d -s claude \
    -e PATH=%h/.local/bin:%h/.local/scripts:/usr/local/bin:/usr/bin:/bin \
    /usr/bin/claude remote-control --spawn worktree --no-create-session-in-dir --permission-mode acceptEdits
ExecStop=/usr/bin/tmux -L claude kill-server
# Not on-failure: the server exits cleanly after ~10 minutes without network.
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
