[Unit]
Description=OliveTin — web buttons for the self-hosted stack
After=network-online.target

[Service]
# A user unit, not a container: gaming-mode drives systemctl --user and the
# container actions call podman directly.
ExecStart=/usr/bin/OliveTin --configdir %h/.config/OliveTin
Restart=on-failure

[Install]
WantedBy=default.target
