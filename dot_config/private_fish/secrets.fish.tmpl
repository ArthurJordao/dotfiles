{{- /* Work API keys, so `work` only. An empty render removes the target:
       chezmoi drops empty files unless the source carries `empty_`. */ -}}
{{- if has "work" (index .hosts .hostname).roles -}}
{{- /* `quote` is right here and wrong in the podman env files. */ -}}
{{- range $name, $field := (onepasswordItemFields .secrets.items.shell .secrets.vault) -}}
set -x {{ $name }} {{ $field.value | quote }}
{{ end -}}
{{- end -}}
