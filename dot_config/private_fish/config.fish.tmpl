{{- $t := index .theme .theme.active -}}
{{- $p := index .palettes $t.palette -}}
set -g fish_greeting
{{ if eq .chezmoi.os "darwin" -}}
fish_add_path "/opt/homebrew/bin"
{{ end -}}
fish_add_path "$HOME/.local/bin"
fish_add_path "$HOME/.local/scripts"
fish_add_path "$HOME/.ghcup/bin"
fish_add_path "$HOME/.cache/rebar3/bin"
fish_add_path "$HOME/.bun/bin"

set -x GPG_TTY $(tty)
set -x GOPATH "$HOME/go"
{{ if eq .chezmoi.os "darwin" -}}
set -x GOROOT "$(/opt/homebrew/bin/brew --prefix golang)/libexec"
{{ else -}}
command -q go && set -x GOROOT (go env GOROOT)
{{ end -}}
fish_add_path "$GOPATH/bin"
test -n "$GOROOT" && fish_add_path "$GOROOT/bin"

set -x EDITOR nvim
set -x BAT_THEME ansi
command -q vivid && set -x LS_COLORS "$(vivid generate {{ $t.vivid }})"
set -x COLORTERM truecolor

command -q direnv && direnv hook fish | source
fish_config theme choose {{ $t.fish | quote }}
command -q fzf_configure_bindings && fzf_configure_bindings --processes=\cb --directory=\cf --git_log=\ct --git_status=\cs
# -g, not -U: a universal variable persists in the chezmoi-ignored
# fish_variables, so the old theme's colors survive a switch.
set -gx FZF_DEFAULT_OPTS "\
--color=bg+:{{ $p.base02 }},bg:{{ $p.base00 }},spinner:{{ $p.base06 }},hl:{{ $p.base08 }} \
--color=fg:{{ $p.base05 }},header:{{ $p.base08 }},info:{{ $p.base0E }},pointer:{{ $p.base06 }} \
--color=marker:{{ $p.base06 }},fg+:{{ $p.base05 }},prompt:{{ $p.base0E }},hl+:{{ $p.base08 }}"
bind \e\[1\;2D backward-word
bind \e\[1\;2C forward-word

test -f "$HOME/.config/fish/secrets.fish" && source "$HOME/.config/fish/secrets.fish"
command -q mise && mise activate fish | source
