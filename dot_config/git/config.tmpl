[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Arthur Bernardi Jordão
	email = arthurbernardijordao@gmail.com
	signingkey = 3AF402314526D39D45CBACA8D62340DADE749208
[core]
	excludesFile = ~/.config/git/ignore
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
{{ if has "dev" (index .hosts .hostname).roles -}}
{{- /* Only a host that imports the signing key can sign. */ -}}
[commit]
	gpgsign = true
{{ end -}}
[url "ssh://git@github.com/"]
	insteadOf = https://github.com/
[includeIf "gitdir:~/dev/noredink/"]
  path = ~/.config/git/work-config
