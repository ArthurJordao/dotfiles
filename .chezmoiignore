# ~/nvim — the symlink target lives in the repo (dot_config/symlink_nvim.tmpl).
# No leading slash: newer chezmoi rejects it, and `nvim` doesn't match .config/nvim.
nvim
nvim/**

# Axis 1: OS — things that only exist on a given platform.

{{ if ne .chezmoi.os "darwin" }}
Brewfile
Pictures
Pictures/**
.config/aerospace
.config/aerospace/**
{{ end }}

# Axis 2: role — gated by what the box is FOR.

{{ if not (or (has "ddns" $roles) (has "minecraft" $roles)) }}
.config/systemd
.config/systemd/**
{{ end }}
{{ if not (has "ddns" $roles) }}
.config/systemd/user/cloudflare-ddns.service
.config/systemd/user/cloudflare-ddns.timer
{{ end }}
{{ if not (has "minecraft" $roles) }}
.config/systemd/user/minecraft@.service
.config/systemd/user/minecraft-backup.service
.config/systemd/user/minecraft-backup.timer
.local/scripts/minecraft
.local/scripts/minecraft-backup
{{ end }}
{{ if not (and (has "server" $roles) (has "gaming" $roles)) }}
.local/scripts/gaming-mode
{{ end }}
{{ if not (has "sunshine" $roles) }}
.config/sunshine
.config/sunshine/**
{{ end }}
{{ if not (has "emulation" $roles) }}
Emulation
Emulation/**
.var
.var/**
.local/state
.local/state/**
.local/scripts/emu-sync-check
.local/scripts/emu-merge-gamelists
{{ end }}
{{ if ne .chezmoi.os "linux" }}
.local/scripts/install-packages
{{ end }}

# Axis 3: placement. Which containers live on THIS host.
# The negation needs the single-star `*`; `**` here silently ignores everything.
{{ if not (has "podman" $roles) }}
.config/containers
.config/containers/**
{{ else }}
.config/containers/systemd/*
{{ range (index $me "quadlets" | default list) -}}
!.config/containers/systemd/{{ . }}*
{{ end -}}
{{ end }}
