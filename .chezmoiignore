# Axis 2: role — gated by what the box is FOR.

{{ if not (or (has "minecraft" $roles) (has "server" $roles) (has "agent" $roles)) }}
.config/systemd
.config/systemd/**
{{ end }}
{{ if not (has "agent" $roles) }}
.config/systemd/user/claude-remote-control.service
{{ end }}
{{ if not (has "minecraft" $roles) }}
.config/systemd/user/minecraft@.service
.config/systemd/user/minecraft-backup.service
.config/systemd/user/minecraft-backup.timer
.local/scripts/minecraft
.local/scripts/minecraft-backup
.local/scripts/check-paper
.local/scripts/paper-upgrade
minecraft
minecraft/**
{{ end }}
{{/* One role, not a conjunction: the old `server` AND `gaming` gate matched
      nobody once the services moved to pluto, and a gate that can silently
      match no host is the failure this is avoiding. CANDIDATES is derived per
      host, so a gaming box with nothing to stop gets a no-op rather than a
      missing script. */}}
{{ if not (has "gaming" $roles) }}
.local/scripts/gaming-mode
{{ end }}
{{ if not (has "podman" $roles) }}
.local/scripts/check-live
{{ end }}
{{ if not (has "sunshine" $roles) }}
.config/sunshine
.config/sunshine/**
.local/scripts/sunshine-client-mode
{{ end }}
{{ if not (has "server" $roles) }}
.config/systemd/user/olivetin.service
.config/systemd/user/notes-backup.service
.config/systemd/user/notes-backup.timer
.config/systemd/user/check-paper-remote.service
.config/systemd/user/check-paper-remote.timer
.config/OliveTin
.config/OliveTin/**
.local/scripts/dashboard-status
.local/scripts/notes-backup
{{ end }}
{{/* Not a role: whether a host has hand-installed binaries falls out of its
      distro and roles together, so the answer is computed in one place. The
      units would otherwise deploy to every server/minecraft/agent host, whose
      .config/systemd gate is broader than this. */}}
{{ if not (includeTemplate "has-firewall" .) }}
.local/scripts/firewall
{{ end }}
{{ if not (includeTemplate "has-binaries" .) }}
.local/scripts/check-binaries
.local/scripts/binaries-build
.config/systemd/user/check-binaries.service
.config/systemd/user/check-binaries.timer
{{ end }}
{{ if has "arkos" $roles }}
{{/* The ROM tree is a vfat mount: it cannot store the modes chezmoi wants,
     so every apply would re-prompt forever. Matching the mount's masks is
     not an option either -- it would strip +x from the PortMaster scripts.
     The .stignore there is maintained by hand. */}}
Emulation/roms
Emulation/roms/**
{{ end }}
{{ if not (has "emulation" $roles) }}
Emulation
Emulation/**
.var
.var/**
.local/state
.local/state/**
.local/scripts/check-emu-sync
.local/scripts/emu-merge-gamelists
{{ end }}
{{ if ne $me.os "linux" }}
.local/scripts/install-packages
{{ end }}

# Axis 3: placement. Which containers live on THIS host.
# Inverted on purpose: ignoring every *other* host's quadlets by exact name
# leaves anything unclaimed unignored, so `exact_systemd` prunes it. A name is a
# directory or the stem before the first dot -- never a prefix, which would let
# one host's `shelf` swallow another's `shelfmark`.
{{ if not (has "blocky" (index $me "quadlets" | default list)) }}
.config/blocky
.config/blocky/**
.local/scripts/blocky
{{ end }}
{{ if not (has "podman" $roles) }}
.config/containers
.config/containers/**
{{ else }}
{{- $mine := index $me "quadlets" | default list -}}
{{- range $h := .hosts -}}
{{- range (index $h "quadlets" | default list) -}}
{{- if not (has . $mine) }}
.config/containers/systemd/{{ . }}
.config/containers/systemd/{{ . }}/**
.config/containers/systemd/{{ . }}.*
{{- end -}}
{{- end -}}
{{- end }}
{{ end }}
